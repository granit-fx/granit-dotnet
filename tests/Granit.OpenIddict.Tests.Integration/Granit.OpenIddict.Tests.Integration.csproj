    <ProjectReference Include="..\..\src\Granit.OpenIddict.Endpoints\Granit.OpenIddict.Endpoints.csproj" />
    <ProjectReference Include="..\..\src\Granit.Identity.Local.AspNetCore\Granit.Identity.Local.AspNetCore.csproj" />
  </ItemGroup>

