<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.ArchitectureTests.Abstractions</PackageId>
    <Description>Reusable architecture test rules for .NET projects using ArchUnitNET. Enforces layered architecture, class design, CQRS naming, and DTO conventions.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnit" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="FluentValidation" />
    <!-- Inherited from tests/Directory.Build.props — exclude from NuGet package -->
    <PackageReference Update="JunitXml.TestLogger" PrivateAssets="all" ExcludeAssets="runtime;contentFiles;build;buildTransitive;native" />
  </ItemGroup>

</Project>
