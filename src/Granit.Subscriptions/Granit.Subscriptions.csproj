<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Subscriptions</PackageId>
    <Description>Subscription management for Granit. Plan catalog with lifecycle (Draft/Published/Archived), subscription FSM via Granit.Workflow (Trial/Active/PastDue/Suspended/Cancelled/Expired), per-seat pricing, scheduled plan changes via Granit.Scheduling, provider pattern (Internal/Stripe), and integration events for billing orchestration.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Subscriptions.Tests" />
    <InternalsVisibleTo Include="Granit.Subscriptions.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Subscriptions.Wolverine" />
    <InternalsVisibleTo Include="Granit.Subscriptions.Features" />
    <InternalsVisibleTo Include="Granit.Subscriptions.Internal" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Invoicing.Abstractions\Granit.Invoicing.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Scheduling\Granit.Scheduling.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
    <ProjectReference Include="..\Granit.Workflow\Granit.Workflow.csproj" />
  </ItemGroup>

</Project>
