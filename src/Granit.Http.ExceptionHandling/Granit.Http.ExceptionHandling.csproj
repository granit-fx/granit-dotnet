<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Http.ExceptionHandling</PackageId>
    <Description>Centralized exception handling for Granit APIs. Native .NET RFC 7807 (Problem Details) handler, chain of responsibility for HTTP mapping, ISO 27001 5xx error masking in production, systematic OTEL traceId.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.ExceptionHandling.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>

</Project>
