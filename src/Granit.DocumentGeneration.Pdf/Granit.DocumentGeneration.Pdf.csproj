<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.DocumentGeneration.Pdf</PackageId>
    <Description>PDF document generation for Granit. Renders HTML to PDF through Granit.Browsing's IPdfCapability — register a provider package (Granit.Browsing.PuppeteerSharp or Granit.Browsing.Playwright with the Chromium engine) before AddGranitDocumentGenerationPdf().</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.DocumentGeneration.Pdf.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Browsing\Granit.Browsing.csproj" />
    <ProjectReference Include="..\Granit.DocumentGeneration\Granit.DocumentGeneration.csproj" />
  </ItemGroup>

</Project>
