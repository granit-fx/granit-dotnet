<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Metering</PackageId>
    <Description>Usage-based metering for Granit. High-throughput event recording with idempotency-key deduplication, pre-computed rollups (hourly/daily/billing-period) via watermark-based aggregation, quota enforcement with threshold alerts, and integration events for billing orchestration.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Metering.Tests" />
    <InternalsVisibleTo Include="Granit.Metering.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Metering.Wolverine" />
    <InternalsVisibleTo Include="Granit.Metering.BackgroundJobs" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Metering.Abstractions\Granit.Metering.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
  </ItemGroup>

</Project>
