<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Identity.Abstractions</PackageId>
    <Description>Identity contracts for Granit: the identity-provider seam (IIdentityProvider and its reader/writer/role/group/password/credential facets), the IIdentityUser directory shape, IUserLookupService, the identity domain models and integration events, plus the session/device contracts (UserSessionDescriptor, DeviceKind, the session/device providers, session lifecycle events, and the durable IUserSessionRiskStore). Reference this package to consume identity without taking a dependency on a concrete provider, store, or the anomaly-detection engine.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Identity.Abstractions.Tests" />
    <InternalsVisibleTo Include="Granit.Identity.AnomalyDetection" />
    <InternalsVisibleTo Include="Granit.Identity.AnomalyDetection.Tests" />
    <InternalsVisibleTo Include="Granit.Identity.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Identity.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.IpGeolocation.Abstractions\Granit.IpGeolocation.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
  </ItemGroup>

</Project>
