<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Identity.Abstractions</PackageId>
    <Description>Identity session and device contracts for Granit. Provides UserSessionDescriptor (the canonical session shape produced by both the BFF and the identity authority), DeviceKind, the session/device providers, the session lifecycle events, and the durable IUserSessionRiskStore. Reference this package to consume or enrich user sessions without taking a dependency on a specific session store or the anomaly-detection engine.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Identity.Abstractions.Tests" />
    <InternalsVisibleTo Include="Granit.Identity.AnomalyDetection" />
    <InternalsVisibleTo Include="Granit.Identity.AnomalyDetection.Tests" />
    <InternalsVisibleTo Include="Granit.Identity.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Identity.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.IpGeolocation.Abstractions\Granit.IpGeolocation.Abstractions.csproj" />
  </ItemGroup>

</Project>
