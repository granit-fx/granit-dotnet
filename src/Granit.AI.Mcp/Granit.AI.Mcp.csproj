  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.AI\Granit.AI.csproj" />
    <ProjectReference Include="..\Granit.Mcp.Client\Granit.Mcp.Client.csproj" />
  </ItemGroup>

</Project>
