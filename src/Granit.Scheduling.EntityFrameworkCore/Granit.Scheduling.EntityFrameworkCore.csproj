<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Scheduling.EntityFrameworkCore</PackageId>
    <Description>EF Core persistence layer for Granit.Scheduling. Provides SchedulingDbContext, EfScheduledActionStore, and entity configurations for the ScheduledAction aggregate. Compatible with SQL Server and PostgreSQL.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Scheduling.EntityFrameworkCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Scheduling\Granit.Scheduling.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Persistence.EntityFrameworkCore\Granit.Persistence.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
