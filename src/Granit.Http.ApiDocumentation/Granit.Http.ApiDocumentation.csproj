<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Granit.Http.ApiDocumentation</PackageId>
    <Description>OpenAPI documentation and Scalar UI for Granit applications. Generates one OpenAPI document per declared API version, with JWT Bearer security scheme and [InternalApi] endpoint filtering.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.ApiDocumentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Http.ApiVersioning\Granit.Http.ApiVersioning.csproj" />
  </ItemGroup>
</Project>
