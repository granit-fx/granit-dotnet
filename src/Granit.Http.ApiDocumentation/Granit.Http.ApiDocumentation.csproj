<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Granit.Http.ApiDocumentation</PackageId>
    <Description>OpenAPI documentation and URL-based API versioning for Granit applications. Generates one OpenAPI document per declared API version, with JWT Bearer security scheme, [InternalApi] endpoint filtering, and RFC 8594 deprecation headers. Pair with Granit.Http.ApiDocumentation.Scalar for the interactive UI.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.ApiDocumentation.Tests" />
    <!-- The Scalar UI companion reads OAuth2Options.IsConfigured to decide whether to wire
         the Authorization Code popup and CSP relaxations. -->
    <InternalsVisibleTo Include="Granit.Http.ApiDocumentation.Scalar" />
    <InternalsVisibleTo Include="Granit.Http.ApiDocumentation.Scalar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>
</Project>
