<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Catalog</PackageId>
    <Description>Shared product catalog for Granit. Hosts the Product aggregate root used as the join key between Metering, Subscriptions, and Invoicing — the "thing being sold" — with lifecycle (Draft/Published/Archived) and external provider mappings (Stripe, Avalara, Odoo). MVP scope: Host-owned billing catalog. Designed to grow toward multi-tenant e-commerce inventory in a future phase.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Catalog.Tests" />
    <InternalsVisibleTo Include="Granit.Catalog.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Catalog.Endpoints" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Analytics\Granit.Analytics.csproj" />
    <ProjectReference Include="..\Granit.DataExchange.Abstractions\Granit.DataExchange.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Workflow\Granit.Workflow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
