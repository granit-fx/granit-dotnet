<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Granit.Timeline</PackageId>
    <Description>Unified activity stream engine for Granit. Aggregates comments, internal notes, and system logs per entity. Opt-in via ITimelined marker interface, with graceful degradation when Notifications or BlobStorage are absent.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Timeline.Tests" />
    <InternalsVisibleTo Include="Granit.Timeline.Endpoints" />
    <InternalsVisibleTo Include="Granit.Timeline.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Timeline.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
  </ItemGroup>
</Project>
