<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Workspaces.Abstractions</PackageId>
    <Description>Inter-module contracts for Granit.Workspaces (ADR-057 navigation tree): declarative WorkspaceDefinition base class, fluent builder, section / item descriptors, IFeatureProvider for module-side feature catalog declarations, and the typed reference helpers used by hosts to compose workspaces. Pull this package from any base module that exposes features or declares a WorkspaceDefinition; pull Granit.Workspaces only from hosts that resolve and serve the tree.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Workspaces.Abstractions.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>

</Project>
