<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Privacy</PackageId>
    <Description>Reusable PIMS abstractions for data subject rights (GDPR, ISO 27001). Data Subject Export via scatter-gather saga, Data Subject Deletion via events with cooling-off period, Legal Agreements versioning, IDataProviderRegistry.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Privacy.BlobStorage" />
    <InternalsVisibleTo Include="Granit.Privacy.Endpoints.Tests" />
    <InternalsVisibleTo Include="Granit.Privacy.Tests" />
    <!-- LegalDocumentCacheInvalidatedHandler (Granit.Privacy.Wolverine) refreshes the
         internal CompositeLegalDocumentRegistry. -->
    <InternalsVisibleTo Include="Granit.Privacy.Wolverine" />
    <InternalsVisibleTo Include="Granit.Privacy.Wolverine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced ONLY for [SagaIdentity] on the *Eto integration-event contracts
         (PersonalDataRequestedEto, PersonalDataPreparedEto, PersonalDataDeletedEto,
         DeletionDeferredEto, DeletionCancelledEto): the sagas in Granit.Privacy.Wolverine
         correlate on RequestId, which matches none of Wolverine's naming conventions
         (Id / SagaId / {SagaType}Id), so the attribute must live on the contracts and the
         contracts must stay here — a dozen provider packages publish them. The sagas and
         handlers themselves moved to Granit.Privacy.Wolverine.

         ExcludeAssets="analyzers" keeps the Wolverine source generator from running in this
         assembly (no handlers/sagas remain, and its internal GeneratedWolverineTypeLoader
         would collide via InternalsVisibleTo with the one generated in
         Granit.Privacy.Wolverine — CS0436, the same conflict #2540 fixed for BlobStorage). -->
    <PackageReference Include="WolverineFx">
      <ExcludeAssets>analyzers</ExcludeAssets>
      <PrivateAssets>analyzers</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.DataExchange.Abstractions\Granit.DataExchange.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Settings\Granit.Settings.csproj" />
    <ProjectReference Include="..\Granit.Workflow\Granit.Workflow.csproj" />
  </ItemGroup>

</Project>
