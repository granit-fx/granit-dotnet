<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Mentions</PackageId>
    <Description>The @ mention picker, built on Granit.DataLookup with no mention-specific contract: a mention is just an existing lookup source tagged mentionable via AddMentionSource. A single 'mentions' facade source (GET /lookups/mentions) fans the picker across the tagged sources — multi-type search with lenient per-type ACL, plus composite type:value resolve. No changes to the DataLookup framework.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Mentions.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.DataLookup\Granit.DataLookup.csproj" />
    <ProjectReference Include="..\Granit.DataLookup.Abstractions\Granit.DataLookup.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Authorization\Granit.Authorization.csproj" />
  </ItemGroup>

</Project>
