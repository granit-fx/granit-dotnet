<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.UserSessions.Abstractions</PackageId>
    <Description>Shared session read-model and risk contracts for Granit. Provides UserSessionDescriptor (the canonical session shape produced by both the BFF and the identity authority), IUserSessionAnomalyDetector, and the durable IUserSessionRiskStore. Reference this package to consume or enrich sessions without taking a dependency on a specific session store or the anomaly-detection engine.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.UserSessions.Abstractions.Tests" />
    <InternalsVisibleTo Include="Granit.UserSessions.AnomalyDetection" />
    <InternalsVisibleTo Include="Granit.UserSessions.AnomalyDetection.Tests" />
    <InternalsVisibleTo Include="Granit.UserSessions.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.UserSessions.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.IpGeolocation.Abstractions\Granit.IpGeolocation.Abstractions.csproj" />
  </ItemGroup>

</Project>
