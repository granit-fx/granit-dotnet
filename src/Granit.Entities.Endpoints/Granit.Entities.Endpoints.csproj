<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Entities.Endpoints</PackageId>
    <Description>Minimal API endpoints surfacing the Granit entity manifest (ADR-040). Discovery (`GET /api/entities`) returns the per-module tree filtered by user permissions; per-entity manifest (`GET /api/entities/{name}`) aggregates identity, permissions, forms, details, collections, dashboards, exports, views and savedViews into one payload, with FusionCache + ETag and 18-culture localisation.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Entities.Endpoints.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Authorization\Granit.Authorization.csproj" />
    <ProjectReference Include="..\Granit.Caching\Granit.Caching.csproj" />
    <ProjectReference Include="..\Granit.Entities\Granit.Entities.csproj" />
    <ProjectReference Include="..\Granit.Http.ApiDocumentation\Granit.Http.ApiDocumentation.csproj" />
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
    <ProjectReference Include="..\Granit.Validation\Granit.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
