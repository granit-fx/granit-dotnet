  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Documents\Granit.Documents.csproj" />
    <ProjectReference Include="..\Granit.Documents.Endpoints\Granit.Documents.Endpoints.csproj" />
    <ProjectReference Include="..\Granit.Documents.AssetMetadata\Granit.Documents.AssetMetadata.csproj" />
    <ProjectReference Include="..\Granit.Http.ApiDocumentation\Granit.Http.ApiDocumentation.csproj" />
  </ItemGroup>

</Project>
