<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Taxonomy</PackageId>
    <Description>Cross-cutting taxonomy module for Granit. Provides scoped tags and hierarchical categories as a shared primitive for any aggregate root. One physical table with a scope discriminator keeps per-domain autocomplete focused while enabling single-query cross-entity search.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Taxonomy.Tests" />
    <InternalsVisibleTo Include="Granit.Taxonomy.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Taxonomy.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Granit.Taxonomy.Endpoints" />
    <InternalsVisibleTo Include="Granit.Taxonomy.Endpoints.Tests" />
    <InternalsVisibleTo Include="Granit.Taxonomy.BackgroundJobs" />
    <InternalsVisibleTo Include="Granit.Taxonomy.BackgroundJobs.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Persistence\Granit.Persistence.csproj" />
  </ItemGroup>

</Project>
