<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.TextExtraction</PackageId>
    <Description>Pluggable byte-to-text extraction framework. Provides ITextExtractor / ITextExtractionPipeline contracts, plain-text fallback, LimitedStream defensive wrapper, and security caps (decompression, pixel, char-length). Consumed by indexing, AI, and GDPR export modules.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.TextExtraction.Tests" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
