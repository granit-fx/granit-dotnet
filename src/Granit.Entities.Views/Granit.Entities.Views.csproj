<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Entities.Views</PackageId>
    <Description>Runtime domain for the Granit EntityView primitive: aggregate root with immutable basedOn / kind, three visibility levels (Personal / Shared / Tenant), three promotion flags (pinned / default / personal-default), and JSONB state delta over a compiled collection. See ADR-047. Persistence ships in Granit.Entities.Views.EntityFrameworkCore; HTTP endpoints in Granit.Entities.Views.Endpoints.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Entities.Views.Tests" />
    <InternalsVisibleTo Include="Granit.Entities.Views.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Entities.Views.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Granit.Entities.Views.Endpoints" />
    <InternalsVisibleTo Include="Granit.Entities.Views.Endpoints.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Entities.Views.Abstractions\Granit.Entities.Views.Abstractions.csproj" />
  </ItemGroup>

</Project>
