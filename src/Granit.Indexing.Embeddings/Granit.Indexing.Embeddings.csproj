<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Indexing.Embeddings</PackageId>
    <Description>Opt-in semantic + hybrid search add-on for Granit.Indexing. Decorates IIndexer with an embedding generator and decorates ISearchBackend with a hybrid retriever that fuses BM25/tsvector with vector kNN via Reciprocal Rank Fusion (Cormack 2009). Backend-agnostic — concrete vector stores ship in Granit.Indexing.EntityFrameworkCore (pgvector) and Granit.Indexing.Elasticsearch (dense_vector).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Indexing.Embeddings.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Indexing\Granit.Indexing.csproj" />
  </ItemGroup>

</Project>
