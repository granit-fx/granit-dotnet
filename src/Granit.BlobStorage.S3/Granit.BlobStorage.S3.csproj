<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.BlobStorage.S3</PackageId>
    <Description>S3-compatible implementation for Granit.BlobStorage. Pre-signed URL generation via AWSSDK.S3, multi-tenant isolation by prefix (PrefixBlobKeyStrategy), physical object deletion. Compatible with any S3-compatible provider (AWS, MinIO, etc.).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.BlobStorage.S3.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AWS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.BlobStorage\Granit.BlobStorage.csproj" />
    <ProjectReference Include="..\Granit.Observability\Granit.Observability.csproj" />
  </ItemGroup>

</Project>
