<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Browsing</PackageId>
    <Description>Headless browser abstraction layer: IHeadlessBrowser, IBrowserPage, capability discovery (PDF generation, PDF viewer, accessibility tree, tracing, HAR recording), pool management, and sandbox profiles. Concrete implementations (PuppeteerSharp, Playwright) live in separate packages.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Browsing.Tests" />
    <InternalsVisibleTo Include="Granit.Browsing.PuppeteerSharp" />
    <InternalsVisibleTo Include="Granit.Browsing.PuppeteerSharp.Tests" />
    <InternalsVisibleTo Include="Granit.Browsing.Playwright" />
    <InternalsVisibleTo Include="Granit.Browsing.Playwright.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Authorization\Granit.Authorization.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Http.Security\Granit.Http.Security.csproj" />
    <ProjectReference Include="..\Granit.IO\Granit.IO.csproj" />
    <ProjectReference Include="..\Granit.MultiTenancy\Granit.MultiTenancy.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
