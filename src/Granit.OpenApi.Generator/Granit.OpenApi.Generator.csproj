<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Build-only contract-artifact generator: composes every Granit.*.Endpoints
         module and emits one OpenAPI document per module at build time. Never shipped. -->
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>

    <!-- Build-time OpenAPI generation (Microsoft.Extensions.ApiDescription.Server).
         Emits one Granit.OpenApi.Generator_<slug>.json per registered document into
         ./generated, plus an empty default doc (ignored — see generated/.gitignore). -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/generated</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared doc-gen orchestration: OpenApiContractGenerator.RunAsync (per-module slicing, infra
         neutralization, the minimal-API binding probe). Brings Granit + Granit.Http.ApiDocumentation. -->
    <ProjectReference Include="..\Granit.OpenApi.Generation\Granit.OpenApi.Generation.csproj" />
    <!-- Reference every Granit.{Module}.Endpoints via wildcard so a newly added endpoint module
         is picked up automatically (no manual edit here). NOTE: this only auto-wires the compile
         reference. The module still MUST be added to GeneratorModule's [DependsOn] (service config)
         AND GeneratorEndpoints.All (slug + route mapping) — those drive generation, not the glob. -->
    <ProjectReference Include="..\Granit.*.Endpoints\Granit.*.Endpoints.csproj" />
    <!-- The query-engine exposes its HTTP surface (the GET /catalog query catalogue) from
         Granit.QueryEngine.AspNetCore, not a *.Endpoints package, so the wildcard above does
         not cover it. Reference it explicitly to publish a 'query-engine' contract document. -->
    <ProjectReference Include="..\Granit.QueryEngine.AspNetCore\Granit.QueryEngine.AspNetCore.csproj" />
  </ItemGroup>

</Project>
