<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Http.Idempotency</PackageId>
    <Description>HTTP idempotency middleware for public APIs (Stripe-style). First-class IIdempotencyStore contract with atomic transitions (state machine Absent, InProgress, Completed, Tombstoned) and an in-memory Development default. Pair with Granit.Http.Idempotency.StackExchangeRedis for distributed, AES-256-encrypted storage. GDPR/ISO 27001 compliant.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.Idempotency.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Http.Idempotency.Abstractions\Granit.Http.Idempotency.Abstractions.csproj" />
  </ItemGroup>

</Project>
