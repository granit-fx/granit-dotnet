  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Notifications.Endpoints\Granit.Notifications.Endpoints.csproj" />
    <ProjectReference Include="..\Granit.Notifications.MobilePush\Granit.Notifications.MobilePush.csproj" />
    <ProjectReference Include="..\Granit.Validation\Granit.Validation.csproj" />
  </ItemGroup>

</Project>
