<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Authentication.External.GitHub</PackageId>
    <Description>GitHub external login provider for Granit.Authentication.External (via AspNet.Security.OAuth.GitHub). Config-driven from Authentication:External:Providers entries of type "GitHub".</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Authentication.External\Granit.Authentication.External.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Authentication.External.GitHub.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
