<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Parties.Deduplication</PackageId>
    <Description>Three-tier duplicate detection for the Granit.Parties aggregate. Tier 1 looks up canonical email / phone / VAT columns for deterministic hits; Tier 2 uses PostgreSQL pg_trgm trigram blocking on Name; Tier 3 ranks Tier-2 candidates with a weighted-sum of Jaro-Winkler (name), Double Metaphone (last name), normalised Levenshtein (address) and partial email/phone matches. Pluggable into the admin merge wizard via IPartyDuplicateDetector.</Description>
    <IsPackable>true</IsPackable>
    <!-- EF1001: false positive — the detector queries the internal PartiesDbContext via InternalsVisibleTo. -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Parties.Deduplication.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FuzzySharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="SoftWx.Match" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.DataExchange.Abstractions\Granit.DataExchange.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Parties\Granit.Parties.csproj" />
    <ProjectReference Include="..\Granit.Parties.EntityFrameworkCore\Granit.Parties.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Granit.Persistence.EntityFrameworkCore\Granit.Persistence.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
  </ItemGroup>

</Project>
