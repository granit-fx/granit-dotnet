<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Authentication.JwtBearer.EntraId</PackageId>
    <Description>Extension Microsoft Entra ID pour Granit.Authentication.JwtBearer : transformation des claims App Roles, policy Admin, configuration JWT Bearer depuis la section "EntraId".</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Authentication.JwtBearer.EntraId.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- ASP.NET Core shared framework (IClaimsTransformation, JwtBearerOptions, etc.) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Authentication.JwtBearer\Granit.Authentication.JwtBearer.csproj" />
  </ItemGroup>

</Project>
