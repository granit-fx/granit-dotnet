<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Authentication.JwtBearer.GoogleCloud</PackageId>
    <Description>Google Cloud Identity Platform (Firebase Auth) extension for Granit.Authentication.JwtBearer: custom claims transformation, Admin policy, JWT Bearer configuration from the "GoogleCloudAuth" config section.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Authentication.JwtBearer.GoogleCloud.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- ASP.NET Core shared framework (IClaimsTransformation, JwtBearerOptions, etc.) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Authentication.JwtBearer\Granit.Authentication.JwtBearer.csproj" />
  </ItemGroup>

</Project>
