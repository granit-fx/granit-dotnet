<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Geocoding</PackageId>
    <Description>Forward-geocoding engine for Granit. Provider-agnostic core (IGeocodingService over a pluggable IGeocodingProvider chain) with ordered multi-provider fallback, address normalisation, FusionCache-backed result caching with separate success/failure TTLs, and a privacy-first no-op default (no provider resolves to null, never throwing). Provider packages (e.g. Granit.Geocoding.Nominatim) ship separately.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Geocoding.Tests" />
    <InternalsVisibleTo Include="Granit.Geocoding.Nominatim" />
    <InternalsVisibleTo Include="Granit.Geocoding.Nominatim.Tests" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Caching\Granit.Caching.csproj" />
    <ProjectReference Include="..\Granit.Geocoding.Abstractions\Granit.Geocoding.Abstractions.csproj" />
  </ItemGroup>

</Project>
