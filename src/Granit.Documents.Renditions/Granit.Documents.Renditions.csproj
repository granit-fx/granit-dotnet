<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Documents.Renditions</PackageId>
    <Description>Provider-driven rendition (thumbnail / web / print / poster) generation for Granit.Documents. Contracts only — provider implementations live in separate packages: Granit.Documents.Renditions.Imaging (image→image), Granit.Documents.Renditions.Pdf (pdf→image), Granit.Documents.Renditions.Office (office→pdf).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Tests" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Endpoints" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Endpoints.Tests" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Wolverine" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Wolverine.Tests" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Imaging" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Imaging.Tests" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Pdf" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Pdf.Tests" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Office" />
    <InternalsVisibleTo Include="Granit.Documents.Renditions.Office.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Documents\Granit.Documents.csproj" />
  </ItemGroup>

</Project>
