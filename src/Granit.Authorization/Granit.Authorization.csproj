<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Granit.Authorization</PackageId>
    <Description>RBAC (Role-Based Access Control) permission system for Granit applications. Provides permission definitions, ASP.NET Core integration, and caching-aware permission checks.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Authorization.Tests" />
    <InternalsVisibleTo Include="Granit.Authorization.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Authorization.EntityFrameworkCore.Tests" />
    <!-- Required by Castle.DynamicProxy (NSubstitute) to proxy ILogger<InternalType> in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Caching\Granit.Caching.csproj" />
    <ProjectReference Include="..\Granit.DataExchange.Abstractions\Granit.DataExchange.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Entities.Abstractions\Granit.Entities.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
  </ItemGroup>
</Project>
