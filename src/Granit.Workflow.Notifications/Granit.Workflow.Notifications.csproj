<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Workflow.Notifications</PackageId>
    <Description>Approval notification bridge for Granit.Workflow. Routes approval requests to designated approvers via Granit.Notifications. IApproverResolver for pluggable approver resolution.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Workflow.Notifications.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*.html" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Authorization\Granit.Authorization.csproj" />
    <ProjectReference Include="..\Granit.Identity.Abstractions\Granit.Identity.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Workflow\Granit.Workflow.csproj" />
    <ProjectReference Include="..\Granit.Notifications.Abstractions\Granit.Notifications.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Templating\Granit.Templating.csproj" />
  </ItemGroup>

</Project>
