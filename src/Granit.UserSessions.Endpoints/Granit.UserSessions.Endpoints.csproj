<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.UserSessions.Endpoints</PackageId>
    <Description>The canonical user-session HTTP API for Granit: /sessions (list, revoke one, revoke others) and /devices, served through IUserSessionManager. One self-service surface regardless of topology — with or without a BFF, OpenIddict or Keycloak — so a client front targets a single endpoint everywhere.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Granit.Identity" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.UserSessions.Endpoints.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Http.ApiDocumentation\Granit.Http.ApiDocumentation.csproj" />
    <ProjectReference Include="..\Granit.UserSessions\Granit.UserSessions.csproj" />
    <ProjectReference Include="..\Granit.Validation\Granit.Validation.csproj" />
  </ItemGroup>

</Project>
