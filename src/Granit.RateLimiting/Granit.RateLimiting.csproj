<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.RateLimiting</PackageId>
    <Description>Framework-pure, per-tenant rate limiting core for Granit. Sliding window, fixed window, and token bucket algorithms over Redis Lua, in-memory fallback, and plan-based quotas via Granit.Features. HTTP-agnostic — use Granit.Http.RateLimiting for the ASP.NET Core filter and Granit.RateLimiting.Wolverine for the messaging middleware.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.RateLimiting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Features\Granit.Features.csproj" />
  </ItemGroup>

</Project>
