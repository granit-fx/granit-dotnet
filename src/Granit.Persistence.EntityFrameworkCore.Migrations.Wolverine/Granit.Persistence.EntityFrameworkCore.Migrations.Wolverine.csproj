<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Persistence.EntityFrameworkCore.Migrations.Wolverine</PackageId>
    <Description>Wolverine integration for Granit.Persistence.Migrations: batch dispatch via IMessageBus (durable outbox) and cascade handler.</Description>
    <IsPackable>true</IsPackable>
    <!-- EF1001: False positive — EF Core analyzer flags Granit's own Internal types because the namespace contains EntityFrameworkCore -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Persistence.EntityFrameworkCore.Migrations.Wolverine.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <InternalsVisibleTo Include="WolverineHandlers" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Persistence.EntityFrameworkCore.Migrations\Granit.Persistence.EntityFrameworkCore.Migrations.csproj" />
    <ProjectReference Include="..\Granit.Wolverine\Granit.Wolverine.csproj" />
  </ItemGroup>

</Project>
