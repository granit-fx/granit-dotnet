    <ProjectReference Include="..\..\Granit.Identity.OpenIddict\Granit.Identity.OpenIddict.csproj" />
    <ProjectReference Include="..\..\Granit.OpenIddict.Endpoints\Granit.OpenIddict.Endpoints.csproj" />
    <ProjectReference Include="..\..\Granit.OpenIddict.BackgroundJobs\Granit.OpenIddict.BackgroundJobs.csproj" />
  </ItemGroup>

</Project>
