<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Bundle.Essentials</PackageId>
    <Description>Meta-package grouping the essential Granit modules for a minimal API: Core, Timing, Guids, Security, Validation, Persistence, Observability, Http.ExceptionHandling, Diagnostics.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Granit.Core\Granit.Core.csproj" />
    <ProjectReference Include="..\..\Granit.Timing\Granit.Timing.csproj" />
    <ProjectReference Include="..\..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\..\Granit.Security\Granit.Security.csproj" />
    <ProjectReference Include="..\..\Granit.Validation\Granit.Validation.csproj" />
    <ProjectReference Include="..\..\Granit.Persistence\Granit.Persistence.csproj" />
    <ProjectReference Include="..\..\Granit.Observability\Granit.Observability.csproj" />
    <ProjectReference Include="..\..\Granit.Http.ExceptionHandling\Granit.Http.ExceptionHandling.csproj" />
    <ProjectReference Include="..\..\Granit.Diagnostics\Granit.Diagnostics.csproj" />
  </ItemGroup>

</Project>
