<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Notifications.MobilePush</PackageId>
    <Description>Mobile push notification channel for Granit.Notifications. Provides IMobilePushSender abstraction, device token store, and MobilePushNotificationChannel with Keyed Services multi-provider resolution.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Notifications.MobilePush.Tests" />
    <InternalsVisibleTo Include="Granit.Notifications.MobilePush.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Notifications.MobilePush.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Granit.Notifications.Wolverine" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Notifications.Abstractions\Granit.Notifications.Abstractions.csproj" />
  </ItemGroup>

</Project>
