<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Payments.SepaTransfer</PackageId>
    <Description>Self-hosted SEPA bank transfer payment provider for Granit.Payments. Zero external dependency — checkout returns transfer instructions (IBAN, structured reference), reconciliation matches bank statements (CAMT.053, MT940, CSV) to invoices. Sovereignty-capable.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Payments.SepaTransfer.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Payments\Granit.Payments.csproj" />
  </ItemGroup>

</Project>
