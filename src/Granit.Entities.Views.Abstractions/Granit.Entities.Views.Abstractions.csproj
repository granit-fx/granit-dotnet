<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Entities.Views.Abstractions</PackageId>
    <Description>Lightweight contracts for the Granit EntityView primitive: visibility enum, shared-with value object, descriptor record exposed through the manifest's `views` facet, and the closed permission constants. Pull this package from any module that surfaces a saved-view UI (e.g. the manifest endpoints). Pull Granit.Entities.Views only from hosts that resolve the aggregate.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Entities.Views" />
    <InternalsVisibleTo Include="Granit.Entities.Views.Abstractions.Tests" />
    <InternalsVisibleTo Include="Granit.Entities.Views.Tests" />
    <InternalsVisibleTo Include="Granit.Entities.Views.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Entities.Views.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Granit.Entities.Views.Endpoints" />
    <InternalsVisibleTo Include="Granit.Entities.Views.Endpoints.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Entities.Abstractions\Granit.Entities.Abstractions.csproj" />
  </ItemGroup>

</Project>
