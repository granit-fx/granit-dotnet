<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Identity.Federated.Endpoints</PackageId>
    <Description>ASP.NET Core HTTP integration for Granit.Identity.Federated: the login-time UserCacheSyncMiddleware and the UseGranitIdentityUserCacheSync pipeline extension. Keeps the ASP.NET Core dependency out of the federated domain and data-only (EntityFrameworkCore) packages.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Identity.Federated.Endpoints.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Identity.Federated\Granit.Identity.Federated.csproj" />
  </ItemGroup>

</Project>
