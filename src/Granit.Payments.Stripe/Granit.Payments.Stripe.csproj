<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Payments.Stripe</PackageId>
    <Description>Stripe payment provider for Granit.Payments. Implements IPaymentProvider, ICheckoutSessionFactory, IPaymentMethodManager, and IPaymentWebhookVerifier using the Stripe PaymentIntent API.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Payments.Stripe.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Stripe.net" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Parties\Granit.Parties.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Http.Resilience\Granit.Http.Resilience.csproj" />
    <ProjectReference Include="..\Granit.Payments\Granit.Payments.csproj" />
  </ItemGroup>

</Project>
