<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.BlobStorage.GoogleCloud</PackageId>
    <Description>Google Cloud Storage implementation for Granit.BlobStorage. Pre-signed URL generation via Google.Cloud.Storage.V1, multi-tenant isolation by prefix (GoogleCloudBlobKeyStrategy), physical object deletion.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.BlobStorage.GoogleCloud.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Storage.V1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.BlobStorage\Granit.BlobStorage.csproj" />
    <ProjectReference Include="..\Granit.Diagnostics\Granit.Diagnostics.csproj" />
  </ItemGroup>

</Project>
