<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Caching.FusionCache</PackageId>
    <Description>FusionCache provider for Granit.Caching. L1 local memory + L2 Redis + backplane for cross-pod invalidation + fail-safe + factory timeouts + eager refresh + native OpenTelemetry. Replaces Granit.Caching.Hybrid.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Caching.FusionCache.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />
    <PackageReference Include="ZiggyCreatures.FusionCache.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Caching.StackExchangeRedis\Granit.Caching.StackExchangeRedis.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
  </ItemGroup>

</Project>
