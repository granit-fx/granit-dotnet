<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Contacts</PackageId>
    <Description>Central party-management aggregate for Granit, modelled after Odoo's res.partner. A Contact is a generic party (Individual / Company / Department) that can simultaneously play multiple roles (Customer, Supplier, Employee, Lead) via [Flags], support parent-child hierarchy (Person to Company, subsidiary to holding), and carry polyglot external mappings (Stripe / Mollie / Odoo / Sage / NetSuite). Powers Invoicing, Subscriptions, Payments, Tax, CustomerBalance today and Procurement / HR / CRM tomorrow.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Contacts.Tests" />
    <InternalsVisibleTo Include="Granit.Contacts.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Contacts.Endpoints" />
    <InternalsVisibleTo Include="Granit.Contacts.Privacy" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Contacts.Abstractions\Granit.Contacts.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.DataExchange.Abstractions\Granit.DataExchange.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
  </ItemGroup>

</Project>
