<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.CustomerBalance</PackageId>
    <Description>Per-tenant, per-currency credit balance with append-only ledger for the Granit framework. Manages accounting credits (promotional, overpayment surplus, manual adjustments) applied before PSP charges. Not a payment method or e-money system.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.CustomerBalance.Tests" />
    <InternalsVisibleTo Include="Granit.CustomerBalance.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.CustomerBalance.Wolverine" />
    <InternalsVisibleTo Include="Granit.CustomerBalance.BackgroundJobs" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
  </ItemGroup>

</Project>
