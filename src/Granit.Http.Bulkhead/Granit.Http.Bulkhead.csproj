<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Http.Bulkhead</PackageId>
    <Description>Per-tenant bulkhead isolation for Granit. Limits concurrent operations per tenant per resource using System.Threading.RateLimiting.ConcurrencyLimiter. ASP.NET Core endpoint filter (503 Service Unavailable) and Wolverine middleware.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.Bulkhead.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Core\Granit.Core.csproj" />
    <ProjectReference Include="..\Granit.Http.ExceptionHandling\Granit.Http.ExceptionHandling.csproj" />
    <ProjectReference Include="..\Granit.Features\Granit.Features.csproj" />
    <ProjectReference Include="..\Granit.Security\Granit.Security.csproj" />
  </ItemGroup>

</Project>
