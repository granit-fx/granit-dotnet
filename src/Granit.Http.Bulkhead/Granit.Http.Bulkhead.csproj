<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Http.Bulkhead</PackageId>
    <Description>ASP.NET Core binding for Granit.Bulkhead. Per-endpoint bulkhead filter (.RequireGranitBulkhead) limiting concurrent requests per tenant, plus RFC 7807 mapping of BulkheadRejectedException to HTTP 503 Service Unavailable.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.Bulkhead.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Bulkhead\Granit.Bulkhead.csproj" />
    <ProjectReference Include="..\Granit.Http.ExceptionHandling\Granit.Http.ExceptionHandling.csproj" />
  </ItemGroup>

</Project>
