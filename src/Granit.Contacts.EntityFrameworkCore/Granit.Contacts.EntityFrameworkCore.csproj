<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Contacts.EntityFrameworkCore</PackageId>
    <Description>EF Core persistence for Granit.Contacts. ContactsDbContext, EfContactStore, EfContactQueryableSource, and entity configurations for the central Contact aggregate (host-scoped and tenant-scoped) plus its multi-typed addresses, multi-emails, multi-phones, and polyglot external mappings. Compatible with SQL Server and PostgreSQL.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Contacts.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Contacts\Granit.Contacts.csproj" />
    <ProjectReference Include="..\Granit.Persistence.EntityFrameworkCore\Granit.Persistence.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
  </ItemGroup>

</Project>
