<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Invoicing.Abstractions</PackageId>
    <Description>Inter-module contracts for Granit.Invoicing: integration events (*Eto), CreateInvoiceCommand, and shared enums (CollectionMethod, BillingReason, InvoiceSourceType). Reference this package instead of Granit.Invoicing when you only need invoicing contracts without the domain implementation.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>

</Project>
