<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Http.Cookies.EntityFrameworkCore</PackageId>
    <Description>EF Core persistence for the Granit.Http.Cookies consent ledger. Provides an isolated CookiesDbContext, the append-only EfCoreConsentLedger (GDPR Art. 7(1) accountability), a GDPR Art. 17 erasure primitive, and the query-engine source for consent statistics.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.Cookies.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Http.Cookies\Granit.Http.Cookies.csproj" />
    <ProjectReference Include="..\Granit.Persistence.EntityFrameworkCore\Granit.Persistence.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
