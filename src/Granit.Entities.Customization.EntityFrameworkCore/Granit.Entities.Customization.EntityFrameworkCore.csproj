<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Entities.Customization.EntityFrameworkCore</PackageId>
    <Description>EF Core persistence for Granit.Entities.Customization (ADR-053): isolated CustomizationDbContext with audit + soft-delete + tenant-filter interceptors, EntityCustomization table with a unique (TenantId, EntityName, LayoutKind) index and a JSON column for the closed delta vocabulary, plus the EF reader/writer impls that replace the default Null reader. Migrations live in the consuming app per Granit framework convention.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Entities.Customization.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Granit.Entities.Customization.EntityFrameworkCore.Tests.Integration" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Entities.Customization\Granit.Entities.Customization.csproj" />
    <ProjectReference Include="..\Granit.Persistence.EntityFrameworkCore\Granit.Persistence.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
