<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Validation</PackageId>
    <Description>FluentValidation module for Granit. Provides GranitValidator&lt;T&gt; (CascadeMode.Continue), GranitErrorCodeLanguageManager (standardized Validation:* error codes) and validation extensions for international identifiers (IBAN, BIC/SWIFT, SEPA, E.164). See Granit.Validation.Europe for France/Belgium-specific validators.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Validation.Tests" />
    <InternalsVisibleTo Include="Granit.Validation.Finance" />
    <InternalsVisibleTo Include="Granit.Validation.Finance.Tests" />
    <InternalsVisibleTo Include="Granit.Validation.Europe" />
    <InternalsVisibleTo Include="Granit.Validation.Europe.Tests" />
    <InternalsVisibleTo Include="Granit.Validation.NorthAmerica" />
    <InternalsVisibleTo Include="Granit.Validation.NorthAmerica.Tests" />
    <InternalsVisibleTo Include="Granit.Validation.UnitedKingdom" />
    <InternalsVisibleTo Include="Granit.Validation.UnitedKingdom.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Http.ExceptionHandling\Granit.Http.ExceptionHandling.csproj" />
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
