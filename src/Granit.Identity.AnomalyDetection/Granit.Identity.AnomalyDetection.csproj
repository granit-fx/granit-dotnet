<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Identity.AnomalyDetection</PackageId>
    <Description>Opt-in session anomaly detection for Granit.Identity. Always-on deterministic heuristics (impossible travel, new country, new device) plus an opt-in AI layer over Granit.AI IStructuredCompletion classify a session's risk. Verdicts are persisted to IUserSessionRiskStore and a SuspiciousUserSessionDetectedEto is raised for Medium/High risk. Fed only coarse, IP-free features.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Identity.AnomalyDetection.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.AI\Granit.AI.csproj" />
    <ProjectReference Include="..\Granit.IpGeolocation.Abstractions\Granit.IpGeolocation.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Identity.Abstractions\Granit.Identity.Abstractions.csproj" />
  </ItemGroup>

</Project>
