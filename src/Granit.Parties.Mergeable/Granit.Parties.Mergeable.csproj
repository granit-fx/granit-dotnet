<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Parties.Mergeable</PackageId>
    <Description>Wires the Granit.Parties aggregate into the Granit.Mergeable orchestrator. Provides PartyMergeableAggregateAdapter (load + tombstone + chain-collapse) plus the DI extension that registers all the moving parts so consumers only call AddGranitPartiesMergeableEntityFrameworkCore on their host builder. Cross-module reference rewriters (Invoice.PartyId, Subscription.PartyId, etc.) live in their own *.Mergeable packages — see #1287, #1288, #1289, #1290.</Description>
    <IsPackable>true</IsPackable>
    <!-- EF1001: false positive — the adapter accesses the internal PartiesDbContext via InternalsVisibleTo, which is the documented contract. -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Parties.Mergeable.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Mergeable\Granit.Mergeable.csproj" />
    <ProjectReference Include="..\Granit.Mergeable.EntityFrameworkCore\Granit.Mergeable.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Granit.Parties\Granit.Parties.csproj" />
    <ProjectReference Include="..\Granit.Parties.EntityFrameworkCore\Granit.Parties.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
