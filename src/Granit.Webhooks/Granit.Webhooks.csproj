<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Webhooks</PackageId>
    <Description>Outbound webhook delivery engine for Granit. HMAC-SHA256 anti-replay signatures, durable exponential backoff, payload-type agnostic (thin ISO 27001 or fat standard). Uses in-process channels by default; add Granit.Webhooks.Wolverine for durable outbox dispatch.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Webhooks.Tests" />
    <InternalsVisibleTo Include="Granit.Webhooks.Wolverine" />
    <InternalsVisibleTo Include="Granit.Webhooks.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Webhooks.Endpoints" />
    <InternalsVisibleTo Include="Granit.Webhooks.Endpoints.Tests" />
    <InternalsVisibleTo Include="Granit.Webhooks.EntityFrameworkCore.Tests" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.DataExchange.Abstractions\Granit.DataExchange.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Http.Resilience\Granit.Http.Resilience.csproj" />
    <ProjectReference Include="..\Granit.Http.UrlSafety\Granit.Http.UrlSafety.csproj" />
    <ProjectReference Include="..\Granit.Encryption\Granit.Encryption.csproj" />
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
