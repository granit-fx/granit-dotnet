<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.AuditLog.Wolverine</PackageId>
    <Description>Wolverine integration for Granit.AuditLog. Replaces no-op event publishers with IMessageBus-backed implementations and provides handlers that persist Settings and Feature Flags changes as audit log entries with category ConfigurationChange.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.AuditLog.Wolverine.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.AuditLog\Granit.AuditLog.csproj" />
    <ProjectReference Include="..\Granit.Features\Granit.Features.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Settings\Granit.Settings.csproj" />
    <ProjectReference Include="..\Granit.Wolverine\Granit.Wolverine.csproj" />
  </ItemGroup>

</Project>
