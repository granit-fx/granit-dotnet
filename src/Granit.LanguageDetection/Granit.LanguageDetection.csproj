<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.LanguageDetection</PackageId>
    <Description>Cross-cutting language-detection abstractions for the Granit framework. ILanguageDetector + CompositeLanguageDetector priority chain. Concrete implementations ship in dedicated packages (e.g. Granit.LanguageDetection.Lingua).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.LanguageDetection.Tests" />
    <InternalsVisibleTo Include="Granit.LanguageDetection.Lingua" />
    <InternalsVisibleTo Include="Granit.LanguageDetection.Lingua.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>

</Project>
