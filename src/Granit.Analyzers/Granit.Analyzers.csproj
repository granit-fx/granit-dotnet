<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Analyzers</PackageId>
    <!-- Analyzers must target netstandard2.0 to be compatible with all SDK versions -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Roslyn analyzers enforcing Granit conventions: zero-downtime migrations, security best practices, and Entity Framework Core usage rules.</Description>
    <IsPackable>true</IsPackable>
    <!-- Analyzer packages: DLL goes in analyzers/, not in lib/ -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Enable extended analyzer correctness rules (RS1xxx) -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- NU5128: expected for analyzer packages — output goes to analyzers/, not lib/ -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pack the analyzer DLL into the correct NuGet path -->
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- Pack the CodeFixes DLL alongside the analyzer DLL -->
    <None Include="$(MSBuildThisFileDirectory)..\Granit.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\Granit.Analyzers.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt this dev-time analyzer up to the SDK compiler (5.3.0) above the shipped-floor
         central pin (5.0). On a consumer SDK older than 5.3 this only soft-disables the
         analyzer (CS9057, lint off, build unaffected). Keep <= the running csc. See the
         "Roslyn Analyzers" note in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" VersionOverride="5.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
