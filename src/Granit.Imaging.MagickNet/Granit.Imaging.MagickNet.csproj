<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Imaging.MagickNet</PackageId>
    <Description>Magick.NET implementation for Granit.Imaging. Provides IImageProcessor and IImagePipeline with native support for JPEG, PNG, WebP, AVIF, GIF, BMP, TIFF. Fluent API for resize, crop, compress, watermark and EXIF stripping.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Imaging.MagickNet.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
  </ItemGroup>

  <!-- Suppress moderate CVE in Magick.NET 14.12.0 (no patched version available upstream).
       Remove when a fixed version is released. Tracked: GHSA-98cp-rj9f-6v5g -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-98cp-rj9f-6v5g" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Imaging\Granit.Imaging.csproj" />
  </ItemGroup>

</Project>
