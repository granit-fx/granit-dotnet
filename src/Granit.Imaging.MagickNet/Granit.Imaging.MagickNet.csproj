<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Imaging.MagickNet</PackageId>
    <Description>Magick.NET implementation for Granit.Imaging. Provides IImageProcessor and IImagePipeline with native support for JPEG, PNG, WebP, AVIF, GIF, BMP, TIFF. Fluent API for resize, crop, compress, watermark and EXIF stripping.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Imaging.MagickNet.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Imaging\Granit.Imaging.csproj" />
  </ItemGroup>

</Project>
