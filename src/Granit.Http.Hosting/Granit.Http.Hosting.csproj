<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Http.Hosting</PackageId>
    <Description>Host-facing HTTP pipeline defaults for Granit applications: standardized CORS configuration (ISO 27001 wildcard rules, origin validation, auto-applied middleware) and response compression (Brotli + gzip over HTTPS, BREACH documentation, non-overridable text/event-stream exclusion). Consolidates the former Granit.Http.Cors and Granit.Http.ResponseCompression packages.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.Hosting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>

</Project>
