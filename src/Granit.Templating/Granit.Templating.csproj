<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Templating</PackageId>
    <Description>Generic templating foundation for Granit. Pipeline: resolution, rendering, text/HTML output. No third-party dependencies: concrete engines and renderers provided separately (Granit.Templating.Scriban, Granit.DocumentGeneration.*).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Templating.Tests" />
    <InternalsVisibleTo Include="Granit.Templating.Scriban" />
    <InternalsVisibleTo Include="Granit.Templating.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Templating.Workflow" />
    <InternalsVisibleTo Include="Granit.DocumentGeneration" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal types in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
    <ProjectReference Include="..\Granit.Workflow\Granit.Workflow.csproj" />
    <!-- Optional at runtime: ICurrentTenant resolved via GetService — no GranitMultiTenancyModule required -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
