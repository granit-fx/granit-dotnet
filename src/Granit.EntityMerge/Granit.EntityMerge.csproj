<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.EntityMerge</PackageId>
    <Description>Generic merge primitive for Granit aggregates. IMergeable&lt;T&gt; lets an aggregate absorb a duplicate (the loser) into the survivor; IReferenceRewriter&lt;T&gt; lets each module that holds references to T plug into the orchestration. Includes IHasMergeTombstone tombstone state, MergeFieldChoices for per-field admin override, and IMergeService&lt;T&gt; for transactional execution. Used first by Granit.Parties (deduplication) but reusable for any aggregate (catalog products, leads, etc.).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.EntityMerge.Tests" />
    <InternalsVisibleTo Include="Granit.EntityMerge.EntityFrameworkCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>

</Project>
