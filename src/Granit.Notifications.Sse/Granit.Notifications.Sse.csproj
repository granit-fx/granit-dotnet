<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Notifications.Sse</PackageId>
    <Description>Server-Sent Events (SSE) real-time notification channel for Granit.Notifications. Uses native .NET 10 TypedResults.ServerSentEvents() with Channel-based connection management and Wolverine pub/sub for multi-instance scale-out.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Notifications.Sse.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Notifications\Granit.Notifications.csproj" />
    <ProjectReference Include="..\Granit.Validation\Granit.Validation.csproj" />
  </ItemGroup>

</Project>
