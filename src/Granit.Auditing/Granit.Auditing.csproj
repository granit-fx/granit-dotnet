<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Auditing</PackageId>
    <Description>Audit trail runtime for ISO 27001 compliance: durable persistence pipeline, retention cleanup, diagnostics, and the declarative query/export definitions. Contracts and the audit domain model live in Granit.Auditing.Abstractions.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Auditing.Tests" />
    <InternalsVisibleTo Include="Granit.Auditing.BackgroundJobs" />
    <InternalsVisibleTo Include="Granit.Auditing.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Auditing.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Auditing.Abstractions\Granit.Auditing.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.DataExchange.Abstractions\Granit.DataExchange.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
  </ItemGroup>

</Project>
