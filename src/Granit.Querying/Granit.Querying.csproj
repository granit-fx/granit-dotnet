<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Querying</PackageId>
    <Description>Declarative query building for Granit list views. Fluent QueryDefinition API, typed filters with operator inference, FilterGroups/presets/DatePeriod/SavedViews, whitelist-first security. DTOs: QueryRequest, PagedResult, GroupedResult, QueryMetadata.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Querying.Tests" />
    <InternalsVisibleTo Include="Granit.Querying.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Querying.Endpoints" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal types in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>

</Project>
