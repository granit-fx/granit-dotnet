<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Granit.Http.ApiDocumentation.Scalar</PackageId>
    <Description>Scalar interactive API reference UI for Granit applications. Hosts the Scalar UI on top of the OpenAPI documents generated by Granit.Http.ApiDocumentation, with scoped CSP relaxation and OAuth2 Authorization Code popup support.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.ApiDocumentation.Scalar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Http.ApiDocumentation\Granit.Http.ApiDocumentation.csproj" />
    <ProjectReference Include="..\Granit.Http.SecurityHeaders.Abstractions\Granit.Http.SecurityHeaders.Abstractions.csproj" />
  </ItemGroup>
</Project>
