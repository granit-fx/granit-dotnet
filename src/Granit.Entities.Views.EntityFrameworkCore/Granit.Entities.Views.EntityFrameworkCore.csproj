<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Entities.Views.EntityFrameworkCore</PackageId>
    <Description>EF Core persistence for the Granit EntityView aggregate (ADR-047): isolated DbContext, JSONB state persistence, EntityViewSharedWith audience serialization, IEntityViewReader / IEntityViewWriter implementations with closed-permission gating per ADR-047 §6 and audit hooks via the standard AuditedEntityInterceptor pipeline. Pull this package from a host that resolves saved views; pull Granit.Entities.Views alone if you only need the domain types.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Entities.Views.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Granit.Entities.Views.Endpoints" />
    <InternalsVisibleTo Include="Granit.Entities.Views.Endpoints.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Authorization\Granit.Authorization.csproj" />
    <ProjectReference Include="..\Granit.Entities.Views\Granit.Entities.Views.csproj" />
    <ProjectReference Include="..\Granit.Persistence.EntityFrameworkCore\Granit.Persistence.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
