<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Payments</PackageId>
    <Description>Provider-agnostic payment processing for Granit. PaymentTransaction aggregate with 6-state FSM, multi-provider resolution per tenant and payment method type (Stripe, Mollie, SEPA), refunds, disputes, inbound webhook verification, and idempotent charge operations.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Payments.Tests" />
    <InternalsVisibleTo Include="Granit.Payments.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Payments.Wolverine" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Caching\Granit.Caching.csproj" />
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Invoicing.Abstractions\Granit.Invoicing.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Payments.Abstractions\Granit.Payments.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
  </ItemGroup>

</Project>
