<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Http.Cookies.CookieConsent</PackageId>
    <Description>CookieConsent CMP integration for Granit.Http.Cookies: reads the @cookieconsent/core
    consent cookie, maps consent categories to GDPR CookieCategory, and implements IConsentResolver.
    GDPR/ISO 27001 compliant.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.Cookies.CookieConsent.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Http.Cookies\Granit.Http.Cookies.csproj" />
  </ItemGroup>

</Project>
