<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Documents.Renditions.BackgroundJobs</PackageId>
    <Description>Event-driven background generation for Granit.Documents.Renditions (F16.4). Subscribes to DocumentVersionAddedEvent, enumerates the RenditionTypePolicy registry, and runs the rendition pipeline asynchronously per registered target.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Documents.Renditions.BackgroundJobs.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.BackgroundJobs\Granit.BackgroundJobs.csproj" />
    <ProjectReference Include="..\Granit.Documents.Renditions\Granit.Documents.Renditions.csproj" />
  </ItemGroup>

</Project>
