<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Identity.Federated.Analytics</PackageId>
    <Description>Analytics satellite for Granit.Identity.Federated: ships the MetricDefinitions observing the cached federated-identity pool (total and enabled counts). Optional — hosts that don't run analytics omit this package without breaking federated identity flows.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Identity.Federated.Analytics.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
    <ProjectReference Include="..\Granit.Analytics.Abstractions\Granit.Analytics.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Identity.Federated\Granit.Identity.Federated.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
