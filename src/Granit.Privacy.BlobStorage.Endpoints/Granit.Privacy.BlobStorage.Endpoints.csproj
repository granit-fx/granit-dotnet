<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Privacy.BlobStorage.Endpoints</PackageId>
    <Description>HTTP surface for the blob-backed privacy export download: MapGranitPrivacyExportDownload resolves the caller's export request and 302-redirects to a presigned URL. Split from Granit.Privacy.BlobStorage so the data-plumbing package carries no ASP.NET Core framework reference, and from Granit.Privacy.Endpoints so privacy endpoints stay usable without BlobStorage.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Privacy.BlobStorage.Endpoints.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.BlobStorage\Granit.BlobStorage.csproj" />
    <ProjectReference Include="..\Granit.Privacy\Granit.Privacy.csproj" />
    <ProjectReference Include="..\Granit.Validation\Granit.Validation.csproj" />
  </ItemGroup>

</Project>
