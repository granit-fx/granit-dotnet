<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Notifications.Wolverine</PackageId>
    <Description>Wolverine integration for Granit.Notifications: durable outbox-backed notification dispatch via IMessageBus, local queues with exponential backoff retry.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Notifications.Wolverine.Tests" />
    <InternalsVisibleTo Include="WolverineHandlers" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Encryption\Granit.Encryption.csproj" />
    <ProjectReference Include="..\Granit.Notifications\Granit.Notifications.csproj" />
    <ProjectReference Include="..\Granit.Wolverine\Granit.Wolverine.csproj" />
  </ItemGroup>

</Project>
