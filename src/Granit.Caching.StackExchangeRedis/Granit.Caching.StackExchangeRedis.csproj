<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Caching.StackExchangeRedis</PackageId>
    <Description>Redis provider for Granit.Caching. Upgrades FusionCache with L2 Redis distributed cache, Redis pub/sub backplane for cross-pod L1 invalidation, AES-256 encryption, and health checks.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Caching.StackExchangeRedis.Tests" />
    <InternalsVisibleTo Include="Granit.Http.Idempotency.StackExchangeRedis" />
    <InternalsVisibleTo Include="Granit.Http.Idempotency.StackExchangeRedis.Tests" />
    <InternalsVisibleTo Include="Granit.Http.Idempotency.StackExchangeRedis.Tests.Integration" />
    <InternalsVisibleTo Include="Granit.Http.OutputCaching.StackExchangeRedis" />
    <InternalsVisibleTo Include="Granit.Http.OutputCaching.StackExchangeRedis.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Caching\Granit.Caching.csproj" />
    <ProjectReference Include="..\Granit.Observability\Granit.Observability.csproj" />
  </ItemGroup>

</Project>
