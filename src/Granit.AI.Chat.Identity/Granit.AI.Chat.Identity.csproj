<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.AI.Chat.Identity</PackageId>
    <Description>Wires Granit.Identity as an IAIMentionResolver for Granit.AI.Chat: lets the chat @ picker search the identity directory and resolves a @user mention to context, both under the caller's ACLs (ADR-067).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.AI.Chat.Identity.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.AI.Chat\Granit.AI.Chat.csproj" />
    <ProjectReference Include="..\Granit.Identity\Granit.Identity.csproj" />
  </ItemGroup>

</Project>
