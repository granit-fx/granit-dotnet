<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.AI.StackExchangeRedis</PackageId>
    <Description>Redis-backed IAICallRateLimiter for the Granit.AI feature family. Replaces the per-instance in-memory limiter with a distributed sliding-window (Lua, server-side TIME) so the per-tenant LLM call ceiling is enforced once across all replicas — closing the denial-of-wallet gap of the in-process default. (Package rename to Granit.AI.StackExchangeRedis pending — ADR-064.)</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.AI.StackExchangeRedis.Tests.Integration" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.AI\Granit.AI.csproj" />
  </ItemGroup>

</Project>
