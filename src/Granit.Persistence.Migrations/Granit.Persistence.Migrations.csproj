<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Persistence.Migrations</PackageId>
    <Description>Zero-downtime Expand &amp; Contract migrations framework for EF Core. Progress tracking, provider-agnostic multi-tenant isolation and batch orchestration.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Persistence.Migrations.Tests" />
    <InternalsVisibleTo Include="Granit.Persistence.Migrations.Wolverine" />
    <InternalsVisibleTo Include="Granit.Persistence.Migrations.Wolverine.Tests" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Persistence\Granit.Persistence.csproj" />
  </ItemGroup>

</Project>
