<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Contacts.Abstractions</PackageId>
    <Description>Lightweight abstractions for Granit.Contacts. Ships the value objects (ContactId, BillingAddress, Address), the enums (ContactKind, ContactRoles, ContactStatus, AddressKind, PhoneKind), the reserved external-provider names, and the integration events. Reference this package from a downstream module that only needs to publish/consume contact-related events or carry a ContactId on its own aggregates — without inheriting the full Contact aggregate, EF Core, or persistence stack.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Contacts" />
    <InternalsVisibleTo Include="Granit.Contacts.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>

</Project>
