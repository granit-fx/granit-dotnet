<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Http.SecurityHeaders.Endpoints</PackageId>
    <Description>Audit endpoint for the Granit CSP composition surface. Exposes GET /security-headers/csp returning the effective per-endpoint Content-Security-Policy snapshot, gated by DiagnosticsPermissions.Monitoring.Read. Reuses the diagnostics permission — no new localisation keys.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.SecurityHeaders.Endpoints.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Diagnostics.Endpoints\Granit.Diagnostics.Endpoints.csproj" />
    <ProjectReference Include="..\Granit.Http.SecurityHeaders\Granit.Http.SecurityHeaders.csproj" />
    <ProjectReference Include="..\Granit.Http.SecurityHeaders.Abstractions\Granit.Http.SecurityHeaders.Abstractions.csproj" />
  </ItemGroup>

</Project>
