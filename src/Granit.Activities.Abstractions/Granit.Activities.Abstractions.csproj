<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Activities.Abstractions</PackageId>
    <Description>Inter-module contracts for Granit.Activities (ADR-046 cross-entity to-do module): the ActivityType value object, IActivityTypeProvider IoC contributor for cross-module activity-type catalogs, IActivityRegistry interface, and the framework's standard catalog (ToDo / Call / Meeting / Email). Pull this package from any module that contributes activity types or that declares Activities() on an EntityDefinition; pull Granit.Activities only from hosts that resolve and persist activities.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Activities" />
    <InternalsVisibleTo Include="Granit.Activities.Abstractions.Tests" />
    <InternalsVisibleTo Include="Granit.Activities.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
  </ItemGroup>

</Project>
