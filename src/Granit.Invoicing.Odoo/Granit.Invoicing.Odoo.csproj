<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Invoicing.Odoo</PackageId>
    <Description>Odoo external accounting sync for Granit.Invoicing. Implements IInvoiceSyncProvider using Odoo's JSON-RPC API (account.move model). Push invoices on finalization, poll status updates, retrieve Odoo-generated PDFs.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Invoicing.Odoo.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.Http.Resilience\Granit.Http.Resilience.csproj" />
    <ProjectReference Include="..\Granit.Invoicing\Granit.Invoicing.csproj" />
  </ItemGroup>

</Project>
