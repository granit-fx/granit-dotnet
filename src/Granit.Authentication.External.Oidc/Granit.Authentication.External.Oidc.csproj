<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Authentication.External.Oidc</PackageId>
    <Description>Generic OpenID Connect external login provider for Granit.Authentication.External. Config-driven AddOpenIdConnect from Authentication:External:Providers entries of type "Oidc" (set Authority).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Authentication.External\Granit.Authentication.External.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Authentication.External.Oidc.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
