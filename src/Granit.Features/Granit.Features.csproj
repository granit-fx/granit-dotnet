<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Features</PackageId>
    <Description>Framework-pure SaaS feature management core for Granit. Multi-level resolution (Default, Plan, Tenant), IHybridCache, IFeatureChecker, IFeatureLimitGuard for numeric limits. HTTP-agnostic — use Granit.Http.Features for the Minimal-API filter and Granit.Features.Wolverine for the message middleware.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Features.Tests" />
    <InternalsVisibleTo Include="Granit.Features.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Features.EntityFrameworkCore.Tests" />
    <!-- Required by NSubstitute (Castle.DynamicProxy) to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Caching\Granit.Caching.csproj" />
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
    <!-- Optional at runtime: ICurrentTenant resolved via GetService — no GranitMultiTenancyModule required -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
