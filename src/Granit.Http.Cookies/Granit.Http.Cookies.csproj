<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Http.Cookies</PackageId>
    <Description>Centralized HTTP cookie management with Strict Registry Pattern. GDPR consent by design, fail-fast on unregistered cookies. GDPR/ISO 27001 compliant.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Http.Cookies.Tests" />
    <InternalsVisibleTo Include="Granit.Http.Cookies.CookieConsent" />
    <InternalsVisibleTo Include="Granit.Http.Cookies.EntityFrameworkCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Auditing.Abstractions\Granit.Auditing.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.DataExchange.Abstractions\Granit.DataExchange.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
