<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Parties</PackageId>
    <Description>Central party-management aggregate for Granit. A Party is a generic billing identity (Individual / Company / Department) that can simultaneously play multiple roles (Customer, Supplier, Employee, Lead) via [Flags], support parent-child hierarchy (Person to Company, subsidiary to holding), and carry polyglot external mappings (Stripe / Mollie / Odoo / Sage / NetSuite). Powers Invoicing, Subscriptions, Payments, Tax, CustomerBalance today and Procurement / HR / CRM tomorrow.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Parties.Tests" />
    <InternalsVisibleTo Include="Granit.Parties.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Granit.Parties.Endpoints" />
    <InternalsVisibleTo Include="Granit.Parties.Privacy" />
    <InternalsVisibleTo Include="Granit.Parties.Mergeable" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit\Granit.csproj" />
    <ProjectReference Include="..\Granit.Analytics\Granit.Analytics.csproj" />
    <ProjectReference Include="..\Granit.Localization\Granit.Localization.csproj" />
    <ProjectReference Include="..\Granit.Mergeable\Granit.Mergeable.csproj" />
    <ProjectReference Include="..\Granit.Parties.Abstractions\Granit.Parties.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.DataExchange.Abstractions\Granit.DataExchange.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Entities.Abstractions\Granit.Entities.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Guids\Granit.Guids.csproj" />
    <ProjectReference Include="..\Granit.QueryEngine.Abstractions\Granit.QueryEngine.Abstractions.csproj" />
    <ProjectReference Include="..\Granit.Timing\Granit.Timing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
