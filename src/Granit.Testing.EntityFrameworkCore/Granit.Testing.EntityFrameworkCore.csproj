<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Granit.Testing.EntityFrameworkCore</PackageId>
    <Description>EF Core test factories for Granit: InMemoryDbContextFactory and SqliteDbContextFactory with automatic Granit interceptor wiring. Prefer SqliteDbContextFactory for tests requiring real SQL semantics.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Granit.Testing.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granit.Persistence\Granit.Persistence.csproj" />
    <ProjectReference Include="..\Granit.Testing\Granit.Testing.csproj" />
  </ItemGroup>

</Project>
