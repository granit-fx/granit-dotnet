    <PackageVersion Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.*" />
