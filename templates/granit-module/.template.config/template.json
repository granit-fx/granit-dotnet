{
  "$schema": "http://json.schemastore.org/template",
  "author": "Digital Dynamics",
  "classifications": ["Library", "Granit", "Module"],
  "identity": "Granit.Templates.Module",
  "name": "Granit Module Library",
  "shortName": "granit-module",
  "description": "A Granit module library with standard folder structure, module class, OpenTelemetry Metrics/ActivitySource, and a HostApplicationBuilder extension.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "Granit.MyModule",
  "preferNameDirectory": true,
  "defaultName": "Granit.MyModule",
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Target .NET 10"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    },
    "shortName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "stripGranitPrefix",
      "replaces": "MyModule",
      "fileRename": "MyModule"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    }
  },
  "forms": {
    "stripGranitPrefix": {
      "identifier": "replace",
      "pattern": "^Granit\\.",
      "replacement": ""
    }
  },
  "primaryOutputs": [
    {
      "path": "Granit.MyModule.csproj"
    }
  ],
  "postActions": [
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
