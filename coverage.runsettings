<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Exclude source-generated code from coverage -->
          <ExcludeByAttribute>ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- Exclude ASP.NET OpenAPI source generator and compiler-generated interceptors -->
          <!-- Exclude GranitModule subclasses — DI wiring only, no logic to unit test -->
          <!-- Exclude bundle meta-packages — no logic, only [DependsOn] declarations -->
          <Exclude>[*]Microsoft.AspNetCore.OpenApi.Generated*,[*]System.Runtime.CompilerServices.InterceptsLocationAttribute*,[Granit.*]*Module,[Granit.Bundle.*]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
