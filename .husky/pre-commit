#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# dotnet format on staged .cs files — per-project instead of full solution (~3s vs ~75s)
STAGED_CS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cs')
if [ -n "$STAGED_CS" ]; then
    # Find the nearest .csproj for each staged file, deduplicate, then format per project
    PROJECTS=""
    for cs_file in $STAGED_CS; do
        dir=$(dirname "$cs_file")
        while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
            csproj=$(find "$dir" -maxdepth 1 -name '*.csproj' -print -quit 2>/dev/null)
            if [ -n "$csproj" ]; then
                PROJECTS="$PROJECTS $csproj"
                break
            fi
            dir=$(dirname "$dir")
        done
    done
    PROJECTS=$(echo "$PROJECTS" | tr ' ' '\n' | sort -u | tr '\n' ' ')

    for proj in $PROJECTS; do
        # Filter staged files that belong to this project
        proj_dir=$(dirname "$proj")
        proj_files=$(echo "$STAGED_CS" | tr ' ' '\n' | grep "^$proj_dir/" | tr '\n' ' ')
        if [ -n "$proj_files" ]; then
            dotnet format "$proj" --no-restore --include $proj_files
        fi
    done
    echo "$STAGED_CS" | xargs -r git add
fi

gitleaks git --pre-commit --staged --no-banner

# Regenerate .mcp-code-index.json if any C# source or .csproj changed
if git diff --cached --name-only | grep -qE '\.cs$|\.csproj$'; then
  python3 scripts/generate-code-index.py
  git add .mcp-code-index.json
fi

# Regenerate shard filters if test-shards.json or any .csproj changed
if git diff --cached --name-only | grep -qE 'test-shards\.json$|\.csproj$'; then
  python3 scripts/generate-shard-filters.py
  git add .github/shard-filters/*.slnf
fi

# Regenerate domain filters if .slnx or any .csproj changed
if git diff --cached --name-only | grep -qE 'Granit\.slnx$|\.csproj$'; then
  python3 scripts/generate-domain-filters.py
  git add .slnf/*.slnf
fi
