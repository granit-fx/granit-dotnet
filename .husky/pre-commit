#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# dotnet format on staged .cs files — per-project instead of full solution (~3s vs ~75s)
STAGED_CS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cs')
if [ -n "$STAGED_CS" ]; then
    # Find the nearest .csproj for each staged file, deduplicate, then format per project
    PROJECTS=""
    for cs_file in $STAGED_CS; do
        dir=$(dirname "$cs_file")
        while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
            csproj=$(find "$dir" -maxdepth 1 -name '*.csproj' -print -quit 2>/dev/null)
            if [ -n "$csproj" ]; then
                PROJECTS="$PROJECTS $csproj"
                break
            fi
            dir=$(dirname "$dir")
        done
    done
    PROJECTS=$(echo "$PROJECTS" | tr ' ' '\n' | sort -u | tr '\n' ' ')

    for proj in $PROJECTS; do
        # Filter staged files that belong to this project
        proj_dir=$(dirname "$proj")
        proj_files=$(echo "$STAGED_CS" | tr ' ' '\n' | grep "^$proj_dir/" | tr '\n' ' ')
        if [ -n "$proj_files" ]; then
            dotnet format "$proj" --no-restore --include $proj_files
        fi
    done
    echo "$STAGED_CS" | xargs -r git add
fi

gitleaks git --pre-commit --staged --no-banner

# =============================================================================
# Heavy regenerators — MCP code index, shard filters, domain filters.
# =============================================================================
#
# Triggered only when their inputs are staged so artifacts travel with the
# commit that requires them. Avoids the pre-push amend dance (which broke
# fast-forward pushes and required --force-with-lease).

set -eu

STAGED_FILES=$(git diff --cached --name-only)

if echo "$STAGED_FILES" | grep -qE '\.cs$|\.csproj$'; then
    echo "▶ Regenerating .mcp-code-index.json..."
    python3 scripts/generate-code-index.py >/dev/null
fi

if echo "$STAGED_FILES" | grep -qE 'test-shards\.json$|\.csproj$'; then
    echo "▶ Regenerating .github/shard-filters/*.slnf..."
    python3 scripts/generate-shard-filters.py >/dev/null
fi

if echo "$STAGED_FILES" | grep -qE 'Granit\.slnx$|\.csproj$'; then
    echo "▶ Regenerating .slnf/*.slnf..."
    python3 scripts/generate-domain-filters.py >/dev/null
fi

# Stage regenerated artifacts so they're included in this commit.
git add .mcp-code-index.json .github/shard-filters/*.slnf .slnf/*.slnf 2>/dev/null || true
