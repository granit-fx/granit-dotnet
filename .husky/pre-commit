#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# dotnet format on staged .cs files only
STAGED_CS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cs')
if [ -n "$STAGED_CS" ]; then
    dotnet format Granit.slnx --no-restore --include $STAGED_CS
    echo "$STAGED_CS" | xargs -r git add
fi

gitleaks git --pre-commit --staged --no-banner

# Regenerate code-index.json if any C# source or .csproj changed
if git diff --cached --name-only | grep -qE '\.cs$|\.csproj$'; then
  python3 scripts/generate-code-index.py
  git add code-index.json
fi
