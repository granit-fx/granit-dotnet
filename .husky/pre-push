#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# =============================================================================
# PR state check — block push to branches with a merged or closed PR/MR.
# =============================================================================
#
# Protects against orphan commits on already-merged feature branches. Skipped
# for main/develop (branch protection handles those). Supports GitHub (gh) and
# GitLab (glab) based on the origin URL.
#
# Heavy regenerators (code index, shard filters, domain filters) run in
# pre-commit — see .husky/pre-commit. They amended HEAD in pre-push previously
# but that broke fast-forward pushes.

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)

if [ -n "$BRANCH" ] && [ "$BRANCH" != "main" ] && [ "$BRANCH" != "develop" ]; then
    REMOTE_URL=$(git remote get-url origin 2>/dev/null || true)

    case "$REMOTE_URL" in
        *github.com*)
            if command -v gh >/dev/null 2>&1; then
                PR_JSON=$(gh pr list --head "$BRANCH" --state all --json number,state 2>/dev/null || true)
                if [ -n "$PR_JSON" ] && [ "$PR_JSON" != "[]" ]; then
                    BLOCKED=$(echo "$PR_JSON" | jq -r '.[] | select(.state == "MERGED" or .state == "CLOSED") | "PR #\(.number) (\(.state))"' 2>/dev/null)
                    if [ -n "$BLOCKED" ]; then
                        echo ""
                        echo "🚫 PUSH BLOCKED — branch '$BRANCH' has a merged/closed PR:"
                        echo "$BLOCKED"
                        echo ""
                        echo "Create a new branch from develop instead:"
                        echo "  git checkout -b <new-branch> origin/develop"
                        echo "  git cherry-pick <commits>"
                        echo "  git push -u origin <new-branch>"
                        echo ""
                        exit 1
                    fi
                fi
            else
                echo "⚠️  pre-push: gh CLI not found, skipping PR state check"
            fi
            ;;
        *gitlab*)
            if command -v glab >/dev/null 2>&1; then
                GITLAB_HOST=$(echo "$REMOTE_URL" | sed -E 's|.*@([^:/]+).*|\1|')
                export GITLAB_HOST
                MERGED=$(GITLAB_HOST="$GITLAB_HOST" glab mr list --source-branch "$BRANCH" --merged -F json 2>/dev/null || echo "[]")
                CLOSED=$(GITLAB_HOST="$GITLAB_HOST" glab mr list --source-branch "$BRANCH" --closed -F json 2>/dev/null || echo "[]")
                BLOCKED=""
                if [ "$MERGED" != "[]" ] && [ -n "$MERGED" ]; then
                    BLOCKED=$(echo "$MERGED" | jq -r '.[] | "MR !\(.iid) (MERGED)"' 2>/dev/null)
                fi
                if [ "$CLOSED" != "[]" ] && [ -n "$CLOSED" ]; then
                    CLOSED_PART=$(echo "$CLOSED" | jq -r '.[] | "MR !\(.iid) (CLOSED)"' 2>/dev/null)
                    if [ -n "$BLOCKED" ] && [ -n "$CLOSED_PART" ]; then
                        BLOCKED="$BLOCKED
$CLOSED_PART"
                    elif [ -n "$CLOSED_PART" ]; then
                        BLOCKED="$CLOSED_PART"
                    fi
                fi
                if [ -n "$BLOCKED" ]; then
                    echo ""
                    echo "🚫 PUSH BLOCKED — branch '$BRANCH' has a merged/closed MR:"
                    echo "$BLOCKED"
                    echo ""
                    echo "Create a new branch from develop instead:"
                    echo "  git checkout -b <new-branch> origin/develop"
                    echo "  git cherry-pick <commits>"
                    echo "  git push -u origin <new-branch>"
                    echo ""
                    exit 1
                fi
            else
                echo "⚠️  pre-push: glab CLI not found, skipping MR state check"
            fi
            ;;
    esac
fi
