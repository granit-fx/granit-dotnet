---
/**
 * ArchDiagram — interactive layered architecture diagram for the Granit .NET framework.
 * Each layer is a horizontal band; each module is a clickable chip with a tooltip.
 */

interface Module {
  name: string;
  pkg: string;
  href: string;
  tip: string;
}

interface Layer {
  id: string;
  label: string;
  sublabel?: string;
  color: string;       // CSS class suffix: core | data | security | api | infra | obs | business | ai
  modules: Module[];
}

const layers: Layer[] = [
  {
    id: "ai",
    label: "AI",
    sublabel: "Granit.AI.*",
    color: "ai",
    modules: [
      { name: "Querying.AI",     pkg: "Granit.Querying.AI",     href: "/dotnet/ai/natural-language-query/", tip: "Natural Language Query → QueryRequest translation" },
      { name: "DataExchange.AI", pkg: "Granit.DataExchange.AI", href: "/dotnet/ai/import-mapping/",        tip: "AI-suggested CSV/Excel column mapping" },
      { name: "BlobStorage.AI",  pkg: "Granit.BlobStorage.AI",  href: "/dotnet/ai/blob-classification/",   tip: "Blob classification, PII detection in filenames" },
      { name: "Notifications.AI",pkg: "Granit.Notifications.AI",href: "/dotnet/ai/notifications-ai/",      tip: "AI-generated notification content & channel routing" },
      { name: "Timeline.AI",     pkg: "Granit.Timeline.AI",     href: "/dotnet/ai/timeline-ai/",           tip: "Audit trail summaries & anomaly detection" },
      { name: "Workflow.AI",     pkg: "Granit.Workflow.AI",     href: "/dotnet/ai/workflow-ai/",           tip: "Transition recommendations & risk scoring" },
      { name: "Privacy.AI",      pkg: "Granit.Privacy.AI",      href: "/dotnet/ai/privacy-ai/",           tip: "PII detection in free-text fields" },
      { name: "Validation.AI",   pkg: "Granit.Validation.AI",   href: "/dotnet/ai/validation-ai/",        tip: "Content moderation & prompt injection detection" },
      { name: "Imaging.AI",      pkg: "Granit.Imaging.AI",      href: "/dotnet/ai/imaging-ai/",           tip: "OCR, smart crop, automatic alt text" },
      { name: "AI.Extraction",   pkg: "Granit.AI.Extraction",   href: "/dotnet/ai/extraction/",           tip: "Structured document extraction (PDF, images)" },
      { name: "AI.VectorData",   pkg: "Granit.AI.VectorData",   href: "/dotnet/ai/vector-data/",          tip: "Semantic search & RAG via Microsoft.Extensions.VectorData" },
    ],
  },
  {
    id: "business",
    label: "Business Features",
    color: "business",
    modules: [
      { name: "Workflow",            pkg: "Granit.Workflow",            href: "/dotnet/business/workflow/",           tip: "FSM engine, publication lifecycle, approval flows" },
      { name: "DataExchange",        pkg: "Granit.DataExchange",        href: "/dotnet/business/data-exchange/",      tip: "Import pipeline (CSV, Excel) + export presets" },
      { name: "Templating",          pkg: "Granit.Templating",          href: "/dotnet/business/templating/",         tip: "Scriban templates, HTML-to-PDF, data enrichment" },
      { name: "DocumentGeneration",  pkg: "Granit.DocumentGeneration",  href: "/dotnet/business/document-generation/",tip: "PDF rendering pipeline" },
      { name: "Timeline",            pkg: "Granit.Timeline",            href: "/dotnet/business/timeline/",           tip: "Entity activity stream, follow & notify (ISO 27001)" },
      { name: "Querying",            pkg: "Granit.Querying",            href: "/dotnet/business/querying/",           tip: "Column definitions, filters, sorting, pagination" },
      { name: "Webhooks",            pkg: "Granit.Webhooks",            href: "/dotnet/api/webhooks/",                tip: "HMAC-signed outbound webhook delivery" },
    ],
  },
  {
    id: "infra",
    label: "Infrastructure",
    color: "infra",
    modules: [
      { name: "Wolverine",       pkg: "Granit.Wolverine",       href: "/dotnet/infrastructure/wolverine/",      tip: "Message bus, saga, outbox, retry (Wolverine)" },
      { name: "Notifications",   pkg: "Granit.Notifications",   href: "/dotnet/infrastructure/notifications/",  tip: "6-channel notifications: email, SMS, push, in-app, SignalR, SSE" },
      { name: "BackgroundJobs",  pkg: "Granit.BackgroundJobs",  href: "/dotnet/infrastructure/background-jobs/",tip: "Recurring & delayed jobs (Wolverine + Cronos)" },
      { name: "Localization",    pkg: "Granit.Localization",    href: "/dotnet/infrastructure/localization/",   tip: "i18n for 17 cultures, source-generated keys, runtime overrides" },
      { name: "Settings",        pkg: "Granit.Settings",        href: "/dotnet/infrastructure/settings/",       tip: "Layered settings: global → tenant → user" },
      { name: "Features",        pkg: "Granit.Features",        href: "/dotnet/infrastructure/features/",       tip: "Feature flags per tenant/user with inheritance" },
      { name: "MultiTenancy",    pkg: "Granit.MultiTenancy",    href: "/dotnet/infrastructure/multi-tenancy/",  tip: "Tenant resolution, isolation, data filtering" },
      { name: "SignalR",         pkg: "Granit.Notifications.SignalR", href: "/dotnet/infrastructure/notifications/", tip: "Real-time push via ASP.NET Core SignalR" },
    ],
  },
  {
    id: "api",
    label: "API & Web",
    color: "api",
    modules: [
      { name: "API",             pkg: "Granit.API",             href: "/dotnet/api/api/",             tip: "Versioning, OpenAPI, CORS, cookie policy" },
      { name: "Idempotency",     pkg: "Granit.Idempotency",     href: "/dotnet/api/idempotency/",     tip: "Idempotency keys for safe retries" },
      { name: "ExceptionHandling",pkg:"Granit.ExceptionHandling",href: "/dotnet/api/exception-handling/",tip: "RFC 7807 Problem Details, global error mapping" },
    ],
  },
  {
    id: "security",
    label: "Security & Compliance",
    sublabel: "GDPR · ISO 27001",
    color: "security",
    modules: [
      { name: "Authorization",   pkg: "Granit.Authorization",   href: "/dotnet/security/authorization/",   tip: "RBAC, permission checker, policy builder" },
      { name: "Authentication",  pkg: "Granit.Authentication",  href: "/dotnet/security/authentication/",  tip: "JWT Bearer, API key, refresh token pipeline" },
      { name: "Identity",        pkg: "Granit.Identity",        href: "/dotnet/security/identity/",        tip: "Keycloak / EntraID / Cognito, user cache" },
      { name: "Security",        pkg: "Granit.Security",        href: "/dotnet/security/security/",        tip: "Headers, rate limiting, CORS hardening" },
      { name: "Privacy",         pkg: "Granit.Privacy",         href: "/dotnet/security/privacy/",         tip: "GDPR: erasure, data provider registry" },
      { name: "Vault",           pkg: "Granit.Vault",           href: "/dotnet/security/vault-encryption/",tip: "HashiCorp Vault integration, secret rotation" },
      { name: "Encryption",      pkg: "Granit.Encryption",      href: "/dotnet/security/vault-encryption/",tip: "Field-level AES-256-GCM encryption" },
    ],
  },
  {
    id: "data",
    label: "Data",
    color: "data",
    modules: [
      { name: "Persistence",     pkg: "Granit.Persistence",     href: "/dotnet/data/persistence/",     tip: "EF Core interceptors, soft delete, audit, multi-tenancy filters" },
      { name: "Caching",         pkg: "Granit.Caching",         href: "/dotnet/data/caching/",         tip: "HybridCache: in-process + distributed (Redis, SQL)" },
      { name: "BlobStorage",     pkg: "Granit.BlobStorage",     href: "/dotnet/data/blob-storage/",    tip: "Multi-provider: S3, Azure Blob, GCS, FileSystem, Database" },
      { name: "Imaging",         pkg: "Granit.Imaging",         href: "/dotnet/data/imaging/",         tip: "Image processing pipeline (resize, crop, convert)" },
      { name: "ReferenceData",   pkg: "Granit.ReferenceData",   href: "/dotnet/data/reference-data/",  tip: "Seeded lookup tables with tenant overrides" },
      { name: "AI.EntityFrameworkCore", pkg: "Granit.AI.EntityFrameworkCore", href: "/dotnet/ai/", tip: "AI workspace persistence (EF Core)" },
    ],
  },
  {
    id: "core",
    label: "Core",
    color: "core",
    modules: [
      { name: "Core",            pkg: "Granit.Core",            href: "/dotnet/core/module-system/",   tip: "Module system, DependsOn, DI bootstrapping" },
      { name: "Validation",      pkg: "Granit.Validation",      href: "/dotnet/core/validation/",      tip: "FluentValidation integration, endpoint filter" },
      { name: "Analyzers",       pkg: "Granit.Analyzers",       href: "/dotnet/core/analyzers/",       tip: "Roslyn analyzers: cross-module refs, secrets, conventions" },
      { name: "Observability",   pkg: "Granit.Observability",   href: "/dotnet/observability/observability-otlp/", tip: "Serilog, OpenTelemetry, health checks" },
      { name: "AI",              pkg: "Granit.AI",              href: "/dotnet/ai/",                   tip: "AI workspace management, provider abstraction, usage tracking" },
    ],
  },
];
---

<div class="arch-diagram" aria-label="Granit framework architecture diagram">

  <!-- Top cap -->
  <div class="arch-cap arch-cap--top">
    <span class="arch-cap-label">Your Application</span>
    <span class="arch-cap-sub">bundles · endpoints · handlers · pages</span>
  </div>

  <!-- Layers -->
  {layers.map((layer) => (
    <div class={`arch-layer arch-layer--${layer.color}`} id={`arch-${layer.id}`}>
      <div class="arch-layer-header">
        <span class="arch-layer-name">{layer.label}</span>
        {layer.sublabel && <span class="arch-layer-sub">{layer.sublabel}</span>}
      </div>
      <div class="arch-chips">
        {layer.modules.map((mod) => (
          <a
            href={mod.href}
            class="arch-chip"
            data-tip={mod.tip}
            data-pkg={mod.pkg}
            aria-label={`${mod.pkg} — ${mod.tip}`}
          >
            {mod.name}
          </a>
        ))}
      </div>
    </div>
  ))}

  <!-- Bottom cap -->
  <div class="arch-cap arch-cap--bottom">
    <span class="arch-cap-label">ASP.NET Core 10</span>
    <span class="arch-cap-sub">Minimal API · DI · Middleware · EF Core</span>
  </div>

  <!-- Tooltip (positioned by JS) -->
  <div class="arch-tooltip" role="tooltip" aria-hidden="true">
    <div class="arch-tooltip-pkg"></div>
    <div class="arch-tooltip-tip"></div>
  </div>
</div>

<style>
  /* ── Container ── */
  .arch-diagram {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 2rem 0 2.5rem;
    font-family: var(--sl-font);
    container-type: inline-size;
  }

  /* ── Top / Bottom caps ── */
  .arch-cap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-4);
  }
  .arch-cap--top {
    border-radius: 10px 10px 0 0;
    border-bottom: none;
  }
  .arch-cap--bottom {
    border-radius: 0 0 10px 10px;
    border-top: none;
    background: color-mix(in srgb, var(--sl-color-accent) 8%, var(--sl-color-gray-6));
  }
  .arch-cap-label {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--sl-color-white);
  }
  .arch-cap-sub {
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
    font-style: italic;
  }

  /* ── Layer ── */
  .arch-layer {
    display: grid;
    grid-template-columns: 10rem 1fr;
    align-items: start;
    gap: 0;
    border-left: 1px solid var(--sl-color-gray-4);
    border-right: 1px solid var(--sl-color-gray-4);
    border-bottom: 1px solid var(--sl-color-gray-4);
  }

  .arch-layer-header {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.2rem;
    padding: 0.65rem 0.85rem;
    border-right: 1px solid var(--sl-color-gray-4);
    min-height: 100%;
  }
  .arch-layer-name {
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .arch-layer-sub {
    font-size: 0.68rem;
    opacity: 0.7;
    font-style: italic;
  }

  .arch-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    align-content: flex-start;
  }

  /* ── Chip ── */
  .arch-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--sl-font-mono);
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 80ms ease, box-shadow 80ms ease, border-color 80ms ease;
    cursor: pointer;
    white-space: nowrap;
  }
  .arch-chip:hover,
  .arch-chip:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(0,0,0,.25);
    outline: none;
  }

  /* ── Layer color tokens ── */

  /* AI — amber/gold */
  .arch-layer--ai {
    background: color-mix(in srgb, #f59e0b 6%, var(--sl-color-bg));
  }
  .arch-layer--ai .arch-layer-header {
    background: color-mix(in srgb, #f59e0b 12%, var(--sl-color-bg));
    color: #d97706;
  }
  .arch-layer--ai .arch-layer-name { color: #d97706; }
  .arch-layer--ai .arch-chip {
    background: color-mix(in srgb, #f59e0b 15%, var(--sl-color-bg));
    color: #d97706;
    border-color: color-mix(in srgb, #f59e0b 35%, transparent);
  }
  .arch-layer--ai .arch-chip:hover,
  .arch-layer--ai .arch-chip:focus-visible {
    background: color-mix(in srgb, #f59e0b 25%, var(--sl-color-bg));
    border-color: #f59e0b;
  }

  /* Business — teal */
  .arch-layer--business {
    background: color-mix(in srgb, #14b8a6 5%, var(--sl-color-bg));
  }
  .arch-layer--business .arch-layer-header {
    background: color-mix(in srgb, #14b8a6 10%, var(--sl-color-bg));
  }
  .arch-layer--business .arch-layer-name { color: #0d9488; }
  .arch-layer--business .arch-chip {
    background: color-mix(in srgb, #14b8a6 14%, var(--sl-color-bg));
    color: #0d9488;
    border-color: color-mix(in srgb, #14b8a6 30%, transparent);
  }
  .arch-layer--business .arch-chip:hover,
  .arch-layer--business .arch-chip:focus-visible {
    background: color-mix(in srgb, #14b8a6 24%, var(--sl-color-bg));
    border-color: #14b8a6;
  }

  /* Infrastructure — blue */
  .arch-layer--infra {
    background: color-mix(in srgb, #3b82f6 5%, var(--sl-color-bg));
  }
  .arch-layer--infra .arch-layer-header {
    background: color-mix(in srgb, #3b82f6 10%, var(--sl-color-bg));
  }
  .arch-layer--infra .arch-layer-name { color: #2563eb; }
  .arch-layer--infra .arch-chip {
    background: color-mix(in srgb, #3b82f6 13%, var(--sl-color-bg));
    color: #2563eb;
    border-color: color-mix(in srgb, #3b82f6 28%, transparent);
  }
  .arch-layer--infra .arch-chip:hover,
  .arch-layer--infra .arch-chip:focus-visible {
    background: color-mix(in srgb, #3b82f6 22%, var(--sl-color-bg));
    border-color: #3b82f6;
  }

  /* API — cyan */
  .arch-layer--api {
    background: color-mix(in srgb, #06b6d4 5%, var(--sl-color-bg));
  }
  .arch-layer--api .arch-layer-header {
    background: color-mix(in srgb, #06b6d4 10%, var(--sl-color-bg));
  }
  .arch-layer--api .arch-layer-name { color: #0891b2; }
  .arch-layer--api .arch-chip {
    background: color-mix(in srgb, #06b6d4 13%, var(--sl-color-bg));
    color: #0891b2;
    border-color: color-mix(in srgb, #06b6d4 28%, transparent);
  }
  .arch-layer--api .arch-chip:hover,
  .arch-layer--api .arch-chip:focus-visible {
    background: color-mix(in srgb, #06b6d4 22%, var(--sl-color-bg));
    border-color: #06b6d4;
  }

  /* Security — red/rose */
  .arch-layer--security {
    background: color-mix(in srgb, #ef4444 5%, var(--sl-color-bg));
  }
  .arch-layer--security .arch-layer-header {
    background: color-mix(in srgb, #ef4444 10%, var(--sl-color-bg));
  }
  .arch-layer--security .arch-layer-name { color: #dc2626; }
  .arch-layer--security .arch-chip {
    background: color-mix(in srgb, #ef4444 13%, var(--sl-color-bg));
    color: #dc2626;
    border-color: color-mix(in srgb, #ef4444 28%, transparent);
  }
  .arch-layer--security .arch-chip:hover,
  .arch-layer--security .arch-chip:focus-visible {
    background: color-mix(in srgb, #ef4444 22%, var(--sl-color-bg));
    border-color: #ef4444;
  }

  /* Data — green */
  .arch-layer--data {
    background: color-mix(in srgb, #22c55e 5%, var(--sl-color-bg));
  }
  .arch-layer--data .arch-layer-header {
    background: color-mix(in srgb, #22c55e 10%, var(--sl-color-bg));
  }
  .arch-layer--data .arch-layer-name { color: #16a34a; }
  .arch-layer--data .arch-chip {
    background: color-mix(in srgb, #22c55e 13%, var(--sl-color-bg));
    color: #16a34a;
    border-color: color-mix(in srgb, #22c55e 28%, transparent);
  }
  .arch-layer--data .arch-chip:hover,
  .arch-layer--data .arch-chip:focus-visible {
    background: color-mix(in srgb, #22c55e 22%, var(--sl-color-bg));
    border-color: #22c55e;
  }

  /* Core — purple (accent) */
  .arch-layer--core {
    background: color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-bg));
  }
  .arch-layer--core .arch-layer-header {
    background: color-mix(in srgb, var(--sl-color-accent) 10%, var(--sl-color-bg));
  }
  .arch-layer--core .arch-layer-name { color: var(--sl-color-accent); }
  .arch-layer--core .arch-chip {
    background: color-mix(in srgb, var(--sl-color-accent) 13%, var(--sl-color-bg));
    color: var(--sl-color-accent-high);
    border-color: color-mix(in srgb, var(--sl-color-accent) 28%, transparent);
  }
  .arch-layer--core .arch-chip:hover,
  .arch-layer--core .arch-chip:focus-visible {
    background: color-mix(in srgb, var(--sl-color-accent) 22%, var(--sl-color-bg));
    border-color: var(--sl-color-accent);
  }

  /* ── Tooltip ── */
  .arch-tooltip {
    position: fixed;
    z-index: 1000;
    max-width: 260px;
    padding: 0.5rem 0.7rem;
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0,0,0,.4);
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease;
    font-size: 0.78rem;
    line-height: 1.4;
  }
  .arch-tooltip.is-visible { opacity: 1; }
  .arch-tooltip-pkg {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-2);
    margin-bottom: 0.2rem;
  }
  .arch-tooltip-tip { color: var(--sl-color-white); }

  /* ── Responsive: collapse header on small screens ── */
  @container (max-width: 540px) {
    .arch-layer {
      grid-template-columns: 1fr;
    }
    .arch-layer-header {
      border-right: none;
      border-bottom: 1px solid var(--sl-color-gray-4);
      flex-direction: row;
      gap: 0.5rem;
    }
  }
</style>

<script>
  const diagram = document.querySelector('.arch-diagram') as HTMLElement;
  const tooltip = diagram?.querySelector('.arch-tooltip') as HTMLElement;
  const tipPkg  = tooltip?.querySelector('.arch-tooltip-pkg') as HTMLElement;
  const tipText = tooltip?.querySelector('.arch-tooltip-tip') as HTMLElement;

  if (diagram && tooltip) {
    let current: HTMLElement | null = null;

    function show(chip: HTMLElement) {
      tipPkg.textContent  = chip.dataset.pkg  ?? '';
      tipText.textContent = chip.dataset.tip  ?? '';
      tooltip.classList.add('is-visible');
      tooltip.removeAttribute('aria-hidden');
    }

    function hide() {
      tooltip.classList.remove('is-visible');
      tooltip.setAttribute('aria-hidden', 'true');
    }

    function position(e: MouseEvent) {
      const x = e.clientX + 14;
      const y = e.clientY + 14;
      const tw = tooltip.offsetWidth;
      const th = tooltip.offsetHeight;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      tooltip.style.left = (x + tw > vw ? x - tw - 28 : x) + 'px';
      tooltip.style.top  = (y + th > vh ? y - th - 28 : y) + 'px';
    }

    diagram.addEventListener('mousemove', (e) => {
      const chip = (e.target as HTMLElement).closest('.arch-chip') as HTMLElement | null;
      if (chip) {
        if (chip !== current) { current = chip; show(chip); }
        position(e);
      } else if (current) {
        current = null;
        hide();
      }
    });

    diagram.addEventListener('mouseleave', () => { current = null; hide(); });

    // Keyboard: show tooltip on focus
    diagram.addEventListener('focusin', (e) => {
      const chip = (e.target as HTMLElement).closest('.arch-chip') as HTMLElement | null;
      if (chip) { current = chip; show(chip); }
    });
    diagram.addEventListener('focusout', () => { current = null; hide(); });
  }
</script>
