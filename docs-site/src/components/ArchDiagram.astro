---
/**
 * ArchDiagram — interactive layered architecture diagram for the Granit .NET framework.
 * Each layer is a horizontal band; each module is a clickable chip with a tooltip.
 */

interface Module {
  name: string;
  pkg: string;
  href: string;
  tip: string;
}

interface Layer {
  id: string;
  label: string;
  sublabel?: string;
  color: string;       // CSS class suffix: core | data | security | api | infra | obs | business | ai
  modules: Module[];
}

const layers: Layer[] = [
  {
    id: "ai",
    label: "AI",
    sublabel: "Granit.AI.*",
    color: "ai",
    modules: [
      { name: "Querying.AI",     pkg: "Granit.Querying.AI",     href: "/dotnet/ai/natural-language-query/", tip: "Natural Language Query → QueryRequest translation" },
      { name: "DataExchange.AI", pkg: "Granit.DataExchange.AI", href: "/dotnet/ai/import-mapping/",        tip: "AI-suggested CSV/Excel column mapping" },
      { name: "BlobStorage.AI",  pkg: "Granit.BlobStorage.AI",  href: "/dotnet/ai/blob-classification/",   tip: "Blob classification, PII detection in filenames" },
      { name: "Notifications.AI",pkg: "Granit.Notifications.AI",href: "/dotnet/ai/notifications-ai/",      tip: "AI-generated notification content & channel routing" },
      { name: "Timeline.AI",     pkg: "Granit.Timeline.AI",     href: "/dotnet/ai/timeline-ai/",           tip: "Audit trail summaries & anomaly detection" },
      { name: "Workflow.AI",     pkg: "Granit.Workflow.AI",     href: "/dotnet/ai/workflow-ai/",           tip: "Transition recommendations & risk scoring" },
      { name: "Privacy.AI",      pkg: "Granit.Privacy.AI",      href: "/dotnet/ai/privacy-ai/",           tip: "PII detection in free-text fields" },
      { name: "Validation.AI",   pkg: "Granit.Validation.AI",   href: "/dotnet/ai/validation-ai/",        tip: "Content moderation & prompt injection detection" },
      { name: "Imaging.AI",      pkg: "Granit.Imaging.AI",      href: "/dotnet/ai/imaging-ai/",           tip: "OCR, smart crop, automatic alt text" },
      { name: "AI.Extraction",   pkg: "Granit.AI.Extraction",   href: "/dotnet/ai/extraction/",           tip: "Structured document extraction (PDF, images)" },
      { name: "AI.VectorData",   pkg: "Granit.AI.VectorData",   href: "/dotnet/ai/vector-data/",          tip: "Semantic search & RAG via Microsoft.Extensions.VectorData" },
    ],
  },
  {
    id: "business",
    label: "Business Features",
    color: "business",
    modules: [
      { name: "Workflow",            pkg: "Granit.Workflow",            href: "/dotnet/business/workflow/",           tip: "FSM engine, publication lifecycle, approval flows" },
      { name: "DataExchange",        pkg: "Granit.DataExchange",        href: "/dotnet/business/data-exchange/",      tip: "Import pipeline (CSV, Excel) + export presets" },
      { name: "Templating",          pkg: "Granit.Templating",          href: "/dotnet/business/templating/",         tip: "Scriban templates, HTML-to-PDF, data enrichment" },
      { name: "DocumentGeneration",  pkg: "Granit.DocumentGeneration",  href: "/dotnet/business/document-generation/",tip: "PDF rendering pipeline" },
      { name: "Timeline",            pkg: "Granit.Timeline",            href: "/dotnet/business/timeline/",           tip: "Entity activity stream, follow & notify (ISO 27001)" },
      { name: "Querying",            pkg: "Granit.Querying",            href: "/dotnet/business/querying/",           tip: "Column definitions, filters, sorting, pagination" },
      { name: "ReferenceData",       pkg: "Granit.ReferenceData",       href: "/dotnet/business/reference-data/",     tip: "Domain reference data: countries, currencies, statuses, lookup APIs" },
    ],
  },
  {
    id: "api",
    label: "API & Http",
    color: "api",
    modules: [
      { name: "ApiDocumentation", pkg: "Granit.Http.ApiDocumentation", href: "/dotnet/api/api-documentation/", tip: "OpenAPI / Swagger configuration and UI" },
      { name: "ApiVersioning",   pkg: "Granit.Http.ApiVersioning",   href: "/dotnet/api/api-versioning/",   tip: "API versioning strategies (URL, header, query)" },
      { name: "Cors",            pkg: "Granit.Http.Cors",       href: "/dotnet/api/cors/",             tip: "CORS policy configuration" },
      { name: "RateLimiting",    pkg: "Granit.RateLimiting",    href: "/dotnet/api/rate-limiting/",    tip: "Rate limiting policies and middleware" },
      { name: "Bulkhead",        pkg: "Granit.Http.Bulkhead",        href: "/dotnet/api/bulkhead/",         tip: "Resilience: per-tenant bulkhead isolation" },
      { name: "Idempotency",     pkg: "Granit.Http.Idempotency", href: "/dotnet/api/idempotency/",       tip: "Idempotent request processing" },
      { name: "ExceptionHandling",pkg:"Granit.ExceptionHandling",href: "/dotnet/api/exception-handling/",tip: "RFC 7807 Problem Details, global error mapping" },
      { name: "Webhooks",        pkg: "Granit.Webhooks",        href: "/dotnet/api/webhooks/",          tip: "HMAC-signed outbound webhook delivery with retry" },
      { name: "ResponseCompression", pkg: "Granit.ResponseCompression", href: "/dotnet/api/response-compression/", tip: "Brotli + gzip with safe HTTPS defaults, SSE exclusion" },
      { name: "Cookies",         pkg: "Granit.Http.Cookies",         href: "/dotnet/security/cookies/",         tip: "Cookie consent management (Klaro) — GDPR/ePrivacy" },
    ],
  },
  {
    id: "infra",
    label: "Infrastructure",
    color: "infra",
    modules: [
      { name: "Wolverine",       pkg: "Granit.Wolverine",       href: "/dotnet/infrastructure/wolverine/",      tip: "Message bus, saga, outbox, retry (Wolverine)" },
      { name: "Notifications",   pkg: "Granit.Notifications",   href: "/dotnet/infrastructure/notifications/",  tip: "6-channel notifications: email, SMS, push, in-app, SignalR, SSE" },
      { name: "BackgroundJobs",  pkg: "Granit.BackgroundJobs",  href: "/dotnet/infrastructure/background-jobs/",tip: "Recurring & delayed jobs (Wolverine + Cronos)" },
      { name: "Localization",    pkg: "Granit.Localization",    href: "/dotnet/infrastructure/localization/",   tip: "i18n for 17 cultures, source-generated keys, runtime overrides" },
      { name: "Settings",        pkg: "Granit.Settings",        href: "/dotnet/infrastructure/settings/",       tip: "Layered settings: global → tenant → user" },
      { name: "Features",        pkg: "Granit.Features",        href: "/dotnet/infrastructure/features/",       tip: "Feature flags per tenant/user with inheritance" },
      { name: "MultiTenancy",    pkg: "Granit.MultiTenancy",    href: "/dotnet/infrastructure/multi-tenancy/",  tip: "Tenant resolution, isolation, data filtering" },
    ],
  },
  {
    id: "security",
    label: "Security & Compliance",
    sublabel: "GDPR · ISO 27001",
    color: "security",
    modules: [
      { name: "AuditLog",        pkg: "Granit.AuditLog",        href: "/dotnet/security/audit-log/",       tip: "Hierarchical audit trail: auto-capture, querying, retention (ISO 27001)" },
      { name: "Authorization",   pkg: "Granit.Authorization",   href: "/dotnet/security/authorization/",   tip: "RBAC, permission checker, policy builder" },
      { name: "Authentication",  pkg: "Granit.Authentication",  href: "/dotnet/security/authentication/",  tip: "JWT Bearer, API key, refresh token pipeline" },
      { name: "Identity",        pkg: "Granit.Identity",        href: "/dotnet/security/identity/",        tip: "Keycloak / EntraID / Cognito, user cache" },
      { name: "Security",        pkg: "Granit.Security",        href: "/dotnet/security/security/",        tip: "Headers, rate limiting, CORS hardening" },
      { name: "Privacy",         pkg: "Granit.Privacy",         href: "/dotnet/security/privacy/",         tip: "GDPR: erasure, data provider registry" },
      { name: "Vault",           pkg: "Granit.Vault",           href: "/dotnet/security/vault-encryption/",           tip: "HashiCorp Vault integration, secret rotation" },
      { name: "Encryption",      pkg: "Granit.Encryption",      href: "/dotnet/security/encryption/",      tip: "Field-level AES-256-GCM encryption" },
      { name: "OpenIddict",     pkg: "Granit.OpenIddict",      href: "/dotnet/security/openiddict/",      tip: "Self-hosted OIDC server, user management, 2FA, passkeys, key rotation" },
    ],
  },
  {
    id: "data",
    label: "Data",
    color: "data",
    modules: [
      { name: "Persistence",     pkg: "Granit.Persistence",     href: "/dotnet/data/persistence/",     tip: "EF Core interceptors, soft delete, audit, optimistic concurrency, multi-tenancy filters" },
      { name: "Caching",         pkg: "Granit.Caching",         href: "/dotnet/data/caching/",         tip: "HybridCache: in-process + distributed (Redis, SQL)" },
      { name: "BlobStorage",     pkg: "Granit.BlobStorage",     href: "/dotnet/data/blob-storage/",    tip: "Multi-provider: S3, Azure Blob, GCS, FileSystem, Database" },
      { name: "Imaging",         pkg: "Granit.Imaging",         href: "/dotnet/data/imaging/",         tip: "Image processing pipeline: resize, crop, convert, watermark" },
    ],
  },
  {
    id: "core",
    label: "Core",
    color: "core",
    modules: [
      { name: "Core",            pkg: "Granit.Core",            href: "/dotnet/core/module-system/",            tip: "Module system, DependsOn, DI bootstrapping, domain primitives" },
      { name: "Validation",      pkg: "Granit.Validation",      href: "/dotnet/core/validation/",               tip: "FluentValidation extensions: Europe, NorthAmerica, UK, AI" },
      { name: "Analyzers",       pkg: "Granit.Analyzers",       href: "/dotnet/core/analyzers/",                tip: "Roslyn analyzers: cross-module refs, secrets, conventions" },
      { name: "Observability",   pkg: "Granit.Observability",   href: "/dotnet/core/observability/",            tip: "OpenTelemetry, metrics, tracing, AI insights" },
      { name: "Diagnostics",     pkg: "Granit.Diagnostics",     href: "/dotnet/core/diagnostics/",              tip: "Health checks, liveness and readiness probes" },
      { name: "Timing",          pkg: "Granit.Timing",          href: "/dotnet/core/timing/",                   tip: "Deterministic time abstraction (TimeProvider)" },
      { name: "Guids",           pkg: "Granit.Guids",           href: "/dotnet/core/guids/",                    tip: "Deterministic and sequential UUID generation" },
      { name: "AI",              pkg: "Granit.AI",              href: "/dotnet/ai/",                            tip: "Chat, embeddings, multi-provider, workspace management" },
    ],
  },
];
---

<div class="arch-diagram" aria-label="Granit framework architecture diagram">

  <!-- Top cap -->
  <div class="arch-cap arch-cap--top">
    <span class="arch-cap-label">Your Application</span>
    <span class="arch-cap-sub">bundles · endpoints · handlers · pages</span>
  </div>

  <!-- Layers -->
  {layers.map((layer) => (
    <div class={`arch-layer arch-layer--${layer.color}`} id={`arch-${layer.id}`}>
      <div class="arch-layer-header">
        <span class="arch-layer-name">{layer.label}</span>
        {layer.sublabel && <span class="arch-layer-sub">{layer.sublabel}</span>}
      </div>
      <div class="arch-chips">
        {layer.modules.map((mod) => (
          <a
            href={mod.href}
            class="arch-chip"
            data-tip={mod.tip}
            data-pkg={mod.pkg}
            aria-label={`${mod.pkg} — ${mod.tip}`}
          >
            {mod.name}
          </a>
        ))}
      </div>
    </div>
  ))}

  <!-- Bottom cap -->
  <div class="arch-cap arch-cap--bottom">
    <span class="arch-cap-label">ASP.NET Core 10</span>
    <span class="arch-cap-sub">Minimal API · DI · Middleware · EF Core</span>
  </div>

  <!-- Tooltip (positioned by JS) -->
  <div class="arch-tooltip" role="tooltip" aria-hidden="true">
    <div class="arch-tooltip-pkg"></div>
    <div class="arch-tooltip-tip"></div>
  </div>
</div>

<style>
  /* ── Container ── */
  .arch-diagram {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 2rem 0 2.5rem;
    font-family: var(--sl-font);
    container-type: inline-size;
  }

  /* ── Top / Bottom caps ── */
  .arch-cap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-4);
  }
  .arch-cap--top {
    border-radius: 10px 10px 0 0;
    border-bottom: none;
  }
  .arch-cap--bottom {
    border-radius: 0 0 10px 10px;
    border-top: none;
    background: color-mix(in srgb, var(--sl-color-accent) 8%, var(--sl-color-gray-6));
  }
  .arch-cap-label {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--sl-color-white);
  }
  .arch-cap-sub {
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
    font-style: italic;
  }

  /* ── Layer ── */
  /* margin: 0 overrides Starlight's .sl-markdown-content margin-block on block elements */
  .arch-cap,
  .arch-layer {
    margin: 0;
  }

  .arch-layer {
    display: grid;
    grid-template-columns: 10rem 1fr;
    align-items: start;
    gap: 0;
    border-left: 1px solid var(--sl-color-gray-4);
    border-right: 1px solid var(--sl-color-gray-4);
    border-bottom: 1px solid var(--sl-color-gray-4);
  }

  .arch-layer-header {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.2rem;
    padding: 0.65rem 0.85rem;
    border-right: 1px solid var(--sl-color-gray-4);
    min-height: 100%;
  }
  .arch-layer-name {
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .arch-layer-sub {
    font-size: 0.68rem;
    opacity: 0.7;
    font-style: italic;
  }

  .arch-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    align-content: flex-start;
  }

  /* ── Chip ── */
  .arch-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--sl-font-mono);
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 80ms ease, box-shadow 80ms ease, border-color 80ms ease;
    cursor: pointer;
    white-space: nowrap;
  }
  .arch-chip:hover,
  .arch-chip:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(0,0,0,.25);
    outline: none;
  }

  /* ── Layer color tokens — gradient: amber (top/AI) → fuchsia → purple → indigo → blue (bottom/Core) ── */

  /* Single rule set driven by --lc (layer color) and --lt (layer text) custom properties */
  .arch-layer {
    background: color-mix(in srgb, var(--lc) 5%, var(--sl-color-bg));
  }
  .arch-layer .arch-layer-header {
    background: color-mix(in srgb, var(--lc) 11%, var(--sl-color-bg));
  }
  .arch-layer .arch-layer-name { color: var(--lt); }
  .arch-layer .arch-layer-sub  { color: var(--lt); }
  .arch-layer .arch-chip {
    background:   color-mix(in srgb, var(--lc) 14%, var(--sl-color-bg));
    color:        var(--lt);
    border-color: color-mix(in srgb, var(--lc) 30%, transparent);
  }
  .arch-layer .arch-chip:hover,
  .arch-layer .arch-chip:focus-visible {
    background:   color-mix(in srgb, var(--lc) 24%, var(--sl-color-bg));
    border-color: var(--lc);
  }

  /* Gradient stops — warm (top) → cool (bottom) */
  .arch-layer--ai       { --lc: #f59e0b; --lt: #b45309; }  /* amber        */
  .arch-layer--business { --lc: #e879f9; --lt: #c026d3; }  /* fuchsia      */
  .arch-layer--api      { --lc: #ec4899; --lt: #db2777; }  /* pink         */
  .arch-layer--infra    { --lc: #7c3aed; --lt: #6d28d9; }  /* violet       — Granit accent */
  .arch-layer--security { --lc: #6366f1; --lt: #4f46e5; }  /* indigo       */
  .arch-layer--data     { --lc: #3b82f6; --lt: #2563eb; }  /* blue         */
  .arch-layer--core     { --lc: #0ea5e9; --lt: #0284c7; }  /* sky blue     */

  /* ── Tooltip ── */
  .arch-tooltip {
    position: fixed;
    z-index: 1000;
    max-width: 260px;
    padding: 0.5rem 0.7rem;
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0,0,0,.4);
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease;
    font-size: 0.78rem;
    line-height: 1.4;
  }
  .arch-tooltip.is-visible { opacity: 1; }
  .arch-tooltip-pkg {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-2);
    margin-bottom: 0.2rem;
  }
  .arch-tooltip-tip { color: var(--sl-color-white); }

  /* ── Responsive: collapse header on small screens ── */
  @container (max-width: 540px) {
    .arch-layer {
      grid-template-columns: 1fr;
    }
    .arch-layer-header {
      border-right: none;
      border-bottom: 1px solid var(--sl-color-gray-4);
      flex-direction: row;
      gap: 0.5rem;
    }
  }
</style>

<script>
  const diagram = document.querySelector('.arch-diagram') as HTMLElement;
  const tooltip = diagram?.querySelector('.arch-tooltip') as HTMLElement;
  const tipPkg  = tooltip?.querySelector('.arch-tooltip-pkg') as HTMLElement;
  const tipText = tooltip?.querySelector('.arch-tooltip-tip') as HTMLElement;

  if (diagram && tooltip) {
    let current: HTMLElement | null = null;

    function show(chip: HTMLElement) {
      tipPkg.textContent  = chip.dataset.pkg  ?? '';
      tipText.textContent = chip.dataset.tip  ?? '';
      tooltip.classList.add('is-visible');
      tooltip.removeAttribute('aria-hidden');
    }

    function hide() {
      tooltip.classList.remove('is-visible');
      tooltip.setAttribute('aria-hidden', 'true');
    }

    function position(e: MouseEvent) {
      const x = e.clientX + 14;
      const y = e.clientY + 14;
      const tw = tooltip.offsetWidth;
      const th = tooltip.offsetHeight;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      tooltip.style.left = (x + tw > vw ? x - tw - 28 : x) + 'px';
      tooltip.style.top  = (y + th > vh ? y - th - 28 : y) + 'px';
    }

    diagram.addEventListener('mousemove', (e) => {
      const chip = (e.target as HTMLElement).closest('.arch-chip') as HTMLElement | null;
      if (chip) {
        if (chip !== current) { current = chip; show(chip); }
        position(e);
      } else if (current) {
        current = null;
        hide();
      }
    });

    diagram.addEventListener('mouseleave', () => { current = null; hide(); });

    // Keyboard: show tooltip on focus
    diagram.addEventListener('focusin', (e) => {
      const chip = (e.target as HTMLElement).closest('.arch-chip') as HTMLElement | null;
      if (chip) { current = chip; show(chip); }
    });
    diagram.addEventListener('focusout', () => { current = null; hide(); });
  }
</script>
