---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import {
  PACKAGE_COUNT,
  CULTURE_COUNT,
  PATTERN_COUNT,
  ADR_COUNT,
} from "../data/constants";

// Server-side syntax highlight (token collector avoids self-matching)
function hl(code: string): string {
  const tokens: Array<[number, number, string]> = [];
  function collect(re: RegExp, cls: string, gi = 0) {
    let m: RegExpExecArray | null;
    while ((m = re.exec(code)) !== null) {
      const s = gi > 0 ? m.index + m[0].indexOf(m[gi]) : m.index;
      const t = gi > 0 ? m[gi] : m[0];
      tokens.push([s, s + t.length, cls]);
    }
  }
  collect(/\/\/(.*)$/gm, "cmt", 0);
  collect(/\b(var|typeof|public|sealed|static|readonly|class|override|void|new|using|namespace|return|get|set|async|await|true|false|null)\b/g, "kw", 1);
  collect(/\b(string|int|long|bool|double|float|decimal|byte|char|object|Guid|DateTime)\b/g, "tp", 1);
  collect(/\b(AppModule|AppDbContext|GranitModule|ServiceConfigurationContext|WebApplication)\b/g, "tp", 1);
  collect(/\.(AddGranit\w*|AddKeycloak|UseNpgsql|UseGranit|CreateBuilder|Build|Run|GetConnectionString|AddSmtp|AddGranitLocalization)\b/g, "mth", 1);
  collect(/"([^"]*)"/g, "str", 0);
  tokens.sort((a, b) => a[0] - b[0] || b[1] - a[1]);
  const kept: typeof tokens = [];
  let le = 0;
  for (const t of tokens) { if (t[0] >= le) { kept.push(t); le = t[1]; } }
  const esc = (s: string) => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  let r = '', p = 0;
  for (const [s, e, c] of kept) { r += esc(code.slice(p, s)) + `<span class="${c}">${esc(code.slice(s, e))}</span>`; p = e; }
  r += esc(code.slice(p));
  r = r.replace(/&lt;(AppModule|AppDbContext|GranitModule)&gt;/g, '&lt;<span class="tp">$1</span>&gt;');
  r = r.replace(/=&gt;/g, '<span class="kw">=&gt;</span>');
  return r;
}

const modules = [
  { id: "persistence", label: "Persistence", dependsOn: "GranitPersistenceModule",
    code: `context.Services.AddGranitDbContext<AppDbContext>(\n            options => options.UseNpgsql(\n                context.Configuration\n                    .GetConnectionString("Default")));` },
  { id: "security", label: "Security", dependsOn: "GranitSecurityModule",
    code: `context.Services.AddGranitAuthentication()\n            .AddKeycloak(context.Configuration);` },
  { id: "observability", label: "Observability", dependsOn: "GranitObservabilityModule",
    code: `context.Services.AddGranitObservability(\n            context.Configuration);` },
  { id: "notifications", label: "Notifications", dependsOn: "GranitNotificationsModule",
    code: `context.Services.AddGranitNotifications()\n            .AddSmtp(context.Configuration);` },
  { id: "localization", label: "Localization", dependsOn: "GranitLocalizationModule",
    code: `context.Services.AddGranitLocalization(\n            options => options.DefaultCulture = "en");` },
];

const defaultActive = [true, true, true, false, false];

// Build all 32 AppModule.cs source strings
function buildModuleCode(activeIndices: number[]): string {
  const attrs = activeIndices.map(i => `[DependsOn(typeof(${modules[i].dependsOn}))]`).join("\n");
  const body = activeIndices.length > 0
    ? activeIndices.map(i => `        ${modules[i].code}`).join("\n\n")
    : "        // Pick modules above to see the code";
  return (attrs ? attrs + "\n" : "") +
    "public class AppModule : GranitModule\n{\n    public override void ConfigureServices(\n        ServiceConfigurationContext context)\n    {\n" +
    body + "\n    }\n}";
}

const combos: Record<string, string> = {};
for (let mask = 0; mask < (1 << modules.length); mask++) {
  const key = modules.map((_, i) => (mask >> i) & 1 ? "1" : "0").join("");
  const activeIndices = modules.map((_, i) => i).filter(i => (mask >> i) & 1);
  combos[key] = hl(buildModuleCode(activeIndices));
}

const defaultKey = defaultActive.map(a => a ? "1" : "0").join("");
const programHtml = hl(`var builder = WebApplication.CreateBuilder(args);\n\nbuilder.AddGranit<AppModule>();\n\nvar app = builder.Build();\napp.UseGranit();\napp.Run();`);
---

<StarlightPage
  frontmatter={{
    title: "Open-Source Modular Framework for .NET Core 10",
    template: "splash",
    hero: { title: "", tagline: "" },
  }}
  headings={[]}
>
  <style is:global>
    /* Override starlight-blog hiding the first content-panel */
    .content-panel:first-of-type { display: block !important; }

    /* ── Layout ── */
    .lp { margin-inline: auto; max-width: 72rem; padding-inline: 1.5rem; }

    /* ── Hero: split layout ── */
    .lp-hero {
      display: grid; gap: 3rem; align-items: center;
      padding-block: 2rem 3rem;
    }
    @media (min-width: 960px) {
      .lp-hero { grid-template-columns: 1fr 1fr; padding-block: 3rem 4rem; }
    }
    .lp-hero-text { max-width: 32rem; }
    .lp-eyebrow {
      font-size: 1.25rem; font-weight: 600;
      color: var(--sl-color-accent); margin-bottom: 0.75rem;
      display: flex; align-items: center; gap: 0.625rem;
    }
    .lp-eyebrow-badge {
      font-size: 0.75rem; font-weight: 700;
      padding: 0.125rem 0.5rem; border-radius: 9999px;
      background: var(--sl-color-accent); color: #fff;
      letter-spacing: 0.02em;
    }
    .lp-h1 {
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 800; line-height: 1.08;
      color: var(--sl-color-white); margin: 0;
    }
    .lp-sub {
      margin-top: 1.25rem; font-size: 1.125rem;
      line-height: 1.6; color: var(--sl-color-gray-2);
    }
    /* Syntax highlighting — Night Owl inspired */
    .kw { color: #c792ea; }
    .tp { color: #82aaff; }
    .attr { color: #ffcb6b; }
    .str { color: #c3e88d; }
    .mth { color: #89ddff; }
    .cmt { color: #637777; font-style: italic; }

    .lp-actions {
      margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem;
    }
    .lp-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      border-radius: 0.5rem; padding: 0.75rem 1.5rem;
      font-weight: 600; font-size: 0.9375rem;
      text-decoration: none; transition: all 0.2s;
    }
    .lp-btn-primary {
      background: var(--sl-color-accent);
      color: var(--sl-color-accent-text-over);
    }
    .lp-btn-primary:hover { opacity: 0.85; }
    .lp-btn-outline {
      border: 1px solid var(--sl-color-gray-5);
      color: var(--sl-color-gray-2);
    }
    .lp-btn-outline:hover {
      border-color: var(--sl-color-gray-3);
      color: var(--sl-color-white);
    }

    /* Hero visual */
    .lp-hero-visual {
      display: flex; align-items: center; justify-content: center;
    }
    .lp-hero-visual img {
      width: 100%; max-width: 520px; height: auto;
    }
    /* ── Accent banner ── */
    .lp-banner {
      border-radius: 0.75rem; padding: 2rem 2.5rem;
      background: var(--sl-color-accent);
      color: var(--sl-color-accent-text-over);
    }
    .lp-banner h2 {
      font-size: 1.75rem; font-weight: 700; margin: 0 0 0.5rem;
      color: #fff;
    }
    .lp-banner p {
      font-size: 1.125rem; line-height: 1.6; margin: 0;
      color: #fff; opacity: 0.9;
    }

    /* ── Section titles ── */
    .lp-section { padding-block: 0.5rem 4rem; }
    .lp-h2 {
      font-size: clamp(1.75rem, 3vw, 2.25rem);
      font-weight: 800; color: var(--sl-color-white);
      margin: 0 0 3rem;
    }

    /* ── Feature grid (2-col like Aspire) ── */
    .lp-features {
      display: grid; gap: 2.5rem;
    }
    @media (min-width: 640px) {
      .lp-features { grid-template-columns: 1fr 1fr; }
    }
    .lp-feature { display: flex; flex-direction: column; gap: 0.75rem; }
    .lp-feature-header {
      display: flex; align-items: center; gap: 0.5rem;
    }
    .lp-feature-icon {
      flex-shrink: 0; width: 1.5rem; height: 1.5rem;
      color: var(--sl-color-accent);
    }
    .lp-feature-icon svg { width: 100%; height: 100%; }
    .lp-feature-title {
      font-size: 1.0625rem; font-weight: 700;
      color: var(--sl-color-white); margin: 0;
      text-decoration: none;
    }
    .lp-feature-title:hover {
      color: var(--sl-color-accent-high);
    }
    .lp-feature-desc {
      font-size: 0.9375rem; color: var(--sl-color-gray-2);
      line-height: 1.5; margin: 0;
    }

    /* ── Module builder ── */
    .lp-builder-intro {
      text-align: center; max-width: 40rem; margin-inline: auto;
      margin-bottom: 2rem; color: var(--sl-color-gray-2);
    }
    .lp-toggles {
      display: flex; flex-wrap: wrap; justify-content: center;
      gap: 0.75rem; margin-bottom: 2.5rem;
    }
    .lp-toggle {
      display: inline-flex; align-items: center; gap: 0.5rem;
      border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem;
      background: var(--sl-color-gray-6); padding: 0.75rem 1.5rem;
      font-size: 0.875rem; color: var(--sl-color-gray-3);
      white-space: nowrap; height: 2.75rem; box-sizing: border-box;
      cursor: pointer; transition: all 0.2s; user-select: none;
      font-family: inherit; margin: 0;
    }
    .lp-toggle:hover {
      border-color: var(--sl-color-gray-3); color: var(--sl-color-gray-2);
    }
    .lp-toggle[data-active="true"] {
      border-color: var(--sl-color-accent);
      background: var(--sl-color-accent);
      color: #fff;
    }
    .lp-toggle[data-active="true"] .lp-toggle-icon { color: #fff; }
    .lp-toggle-icon {
      display: flex; align-items: center; justify-content: center;
      width: 1.25rem; height: 1.25rem; flex-shrink: 0;
      overflow: hidden;
      color: var(--sl-color-accent); transition: color 0.2s;
    }
    .lp-toggle-icon svg { width: 1.25rem; height: 1.25rem; display: block; }
    .lp-code-panel {
      border-radius: 0.75rem; overflow: hidden;
      border: 1px solid var(--sl-color-gray-5);
      background: #1e1e2e;
    }
    :root[data-theme="light"] .lp-code-panel {
      background: #f6f7f9;
    }
    :root[data-theme="light"] .lp-code-content code {
      color: #24292e;
    }
    :root[data-theme="light"] .kw { color: #d73a49; }
    :root[data-theme="light"] .tp { color: #6f42c1; }
    :root[data-theme="light"] .str { color: #22863a; }
    :root[data-theme="light"] .mth { color: #005cc5; }
    :root[data-theme="light"] .cmt { color: #6a737d; }
    :root[data-theme="light"] .attr { color: #e36209; }
    .lp-code-tabs {
      display: flex; gap: 0; border-bottom: 1px solid var(--sl-color-gray-5);
      align-items: stretch;
    }
    .lp-code-tab {
      padding: 0.5rem 1rem; font-size: 0.75rem; font-family: var(--sl-font-mono);
      color: var(--sl-color-gray-3); background: transparent; border: none;
      border-bottom: 2px solid transparent; cursor: pointer;
      transition: color 0.15s, border-color 0.15s; margin: 0 0 -1px 0;
      line-height: 1.5;
    }
    .lp-code-tab:hover { color: var(--sl-color-gray-1); }
    .lp-code-tab[aria-selected="true"] {
      color: var(--sl-color-accent-high); border-bottom-color: var(--sl-color-accent);
    }
    .lp-code-content > div[data-panel] {
      display: none; min-height: 14rem;
    }
    .lp-code-content > div[data-visible="true"] {
      display: block;
    }
    .lp-code-content pre {
      margin: 0; padding: 1.25rem 1.5rem; font-size: 0.8125rem;
      line-height: 1.75; overflow-x: auto;
      border: none; background: transparent; border-radius: 0;
    }
    .lp-code-content code {
      color: #d6deeb; white-space: pre;
      background: transparent; border: none; padding: 0;
    }

    /* ── Stats ── */
    .lp-stats {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 1rem; text-align: center; padding-block: 3rem;
      border-top: 1px solid var(--sl-color-gray-5);
      border-bottom: 1px solid var(--sl-color-gray-5);
    }
    @media (max-width: 480px) {
      .lp-stats { grid-template-columns: repeat(2, 1fr); }
    }
    .lp-stats > div, .lp-stats > a { margin: 0; }
    .lp-stat-link {
      text-decoration: none; color: inherit;
      transition: opacity 0.15s;
    }
    .lp-stat-link:hover { opacity: 0.75; }
    .lp-stat-num {
      font-size: 2rem; font-weight: 800;
      color: var(--sl-color-accent); margin: 0;
    }
    .lp-stat-label {
      font-size: 0.8125rem; color: var(--sl-color-gray-3);
      margin-top: 0.125rem;
    }

    /* ── AI showcase ── */
    .lp-ai-card {
      border-radius: 0.75rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
      background: color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-bg));
      padding: 2.5rem;
    }
    .lp-ai-layout {
      display: grid; gap: 2.5rem; align-items: center;
    }
    @media (min-width: 960px) {
      .lp-ai-layout { grid-template-columns: 1fr 1.5fr; }
    }
    .lp-ai-eyebrow {
      display: flex; align-items: center; gap: 0.5rem;
      font-size: 0.8125rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.07em; color: var(--sl-color-accent);
      margin-bottom: 1rem;
    }
    .lp-ai-eyebrow svg { width: 1rem; height: 1rem; flex-shrink: 0; }
    .lp-ai-h2 {
      font-size: clamp(1.375rem, 2.5vw, 1.875rem);
      font-weight: 800; color: var(--sl-color-white);
      margin: 0 0 0.75rem; line-height: 1.2;
    }
    .lp-ai-sub {
      font-size: 0.9375rem; color: var(--sl-color-gray-2);
      line-height: 1.6; margin: 0 0 1.5rem;
    }
    .lp-ai-sub code {
      font-size: 0.875rem; color: var(--sl-color-accent-high);
      background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
      padding: 0.125rem 0.375rem; border-radius: 0.25rem;
      font-family: var(--sl-font-mono);
    }
    .lp-ai-providers {
      display: flex; flex-wrap: wrap; gap: 0.5rem;
      margin-bottom: 1.75rem; align-items: center;
    }
    .lp-ai-providers-label {
      font-size: 0.75rem; color: var(--sl-color-gray-4);
      margin-right: 0.125rem;
    }
    .lp-ai-provider {
      font-size: 0.75rem; font-weight: 600;
      padding: 0.1875rem 0.625rem; border-radius: 9999px;
      border: 1px solid var(--sl-color-gray-5);
      color: var(--sl-color-gray-3); white-space: nowrap;
    }
    .lp-ai-caps {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.625rem;
    }
    @media (max-width: 480px) {
      .lp-ai-caps { grid-template-columns: repeat(2, 1fr); }
    }
    .lp-ai-cap {
      background: var(--sl-color-bg);
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.625rem; padding: 0.875rem;
      display: flex; flex-direction: column; gap: 0.25rem;
      text-decoration: none;
      transition: border-color 0.15s, transform 0.15s;
    }
    .lp-ai-cap:hover {
      border-color: var(--sl-color-accent); transform: translateY(-1px);
    }
    .lp-ai-cap-icon {
      width: 1.125rem; height: 1.125rem;
      color: var(--sl-color-accent); flex-shrink: 0; margin-bottom: 0.25rem;
    }
    .lp-ai-cap-icon svg { width: 100%; height: 100%; }
    .lp-ai-cap-title {
      font-size: 0.8125rem; font-weight: 700;
      color: var(--sl-color-white); margin: 0;
    }
    .lp-ai-cap-desc {
      font-size: 0.75rem; color: var(--sl-color-gray-3);
      line-height: 1.4; margin: 0;
    }

    /* ── Compliance ── */
    .lp-compliance {
      display: grid; gap: 2.5rem; align-items: center;
      border-radius: 0.75rem; border: 1px solid var(--sl-color-gray-5);
      background: var(--sl-color-gray-6); padding: 2.5rem;
    }
    @media (min-width: 960px) {
      .lp-compliance { grid-template-columns: 1fr 1fr; }
    }
    .lp-compliance h2 {
      font-size: 1.5rem; font-weight: 700;
      color: var(--sl-color-white); margin: 0 0 0.75rem;
    }
    .lp-compliance > div:first-child p {
      color: var(--sl-color-gray-2); line-height: 1.6; margin: 0;
    }
    .lp-badges {
      display: grid; grid-template-columns: 1fr 1fr 1fr;
      gap: 1rem; text-align: center;
    }
    .lp-badge {
      border-radius: 0.5rem; border: 1px solid var(--sl-color-gray-5);
      background: var(--sl-color-bg); padding: 1.75rem 0.5rem;
      margin: 0; display: flex; flex-direction: column; min-width: 0;
      align-items: center; gap: 0.75rem;
    }
    .lp-badge-icon {
      width: 2.5rem; height: 2.5rem; color: var(--sl-color-accent);
    }
    .lp-badge-icon svg { width: 100%; height: 100%; }
    .lp-badge-title {
      font-size: 1.25rem; font-weight: 800;
      color: var(--sl-color-accent);
      white-space: nowrap;
    }
    .lp-badge-sub {
      font-size: 0.75rem; color: var(--sl-color-gray-3);
      margin-top: -0.25rem; white-space: nowrap;
    }

    /* ── CTA ── */
    .lp-cta {
      text-align: center; padding-block: 4rem 2rem;
    }
    .lp-cta p {
      max-width: 36rem; margin: 1rem auto 0;
      color: var(--sl-color-gray-2); line-height: 1.6;
    }
    .lp-cta .lp-actions { margin-top: 2rem; justify-content: center; }

    /* ── Footer ── */
    .lp-footer {
      text-align: center;
      padding: 1rem 1rem 1.5rem;
      color: var(--sl-color-gray-3);
      font-size: 0.875rem;
    }
    .lp-heart { color: #e25555; }

    /* Remove Starlight's default content padding below the landing page */
    .main-pane,
    .content-panel,
    .sl-markdown-content,
    main[data-pagefind-body] { padding-bottom: 0 !important; margin-bottom: 0 !important; }
  </style>

  <!-- ════════ Hero ════════ -->
  <section class="lp lp-hero">
    <div class="lp-hero-text">
      <div class="lp-eyebrow">Granit <span class="lp-eyebrow-badge">.NET 10</span></div>
      <h1 class="lp-h1">Solid by design,<br />modular by nature.</h1>
      <p class="lp-sub">
        A modular <span style="color:var(--sl-color-accent);font-weight:600">.NET 10</span> framework — orchestrate auth, persistence, CQRS, messaging, and {PACKAGE_COUNT - 5}+ more modules
        effortlessly. No boilerplate, no rewrites, no limits.
      </p>
      <div class="lp-actions">
        <a href="/dotnet/getting-started/" class="lp-btn lp-btn-primary">Getting Started</a>
        <a href="/dotnet/" class="lp-btn lp-btn-outline">Explore Docs</a>
      </div>
    </div>
    <div class="lp-hero-visual">
      <img src="/hero-layers.svg" alt="Granit framework layers: Core, Persistence, Messaging, Documents, Observability" width="520" height="440" />
    </div>
  </section>

  <!-- ════════ Banner ════════ -->
  <section class="lp" style="padding-bottom:4rem">
    <div class="lp-banner">
      <h2>Free and open source</h2>
      <p>
        Granit is Apache-2.0 licensed, GDPR &amp; ISO 27001 ready out of the box.
        Build production apps on a framework designed for compliance from day one.
      </p>
    </div>
  </section>

  <!-- ════════ Why Granit ════════ -->
  <section class="lp lp-section">
    <h2 class="lp-h2">Why developers choose Granit</h2>
    <div class="lp-features">
      <div class="lp-feature">
        <div class="lp-feature-header">
          <div class="lp-feature-icon"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-2.25-1.313M21 7.5v2.25m0-2.25l-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3l2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75l2.25-1.313M12 21.75V19.5m0 2.25l-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25" /></svg></div>
          <a href="/dotnet/architecture/patterns/module-system/" class="lp-feature-title">Modular by default</a>
        </div>
        <p class="lp-feature-desc">Topological dependency resolution, lifecycle hooks, and conditional modules. Pick what you need — the graph resolves automatically.</p>
      </div>
      <div class="lp-feature">
        <div class="lp-feature-header">
          <div class="lp-feature-icon"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg></div>
          <a href="/dotnet/data/persistence/" class="lp-feature-title">Persistence & audit</a>
        </div>
        <p class="lp-feature-desc">EF Core interceptors for audit trails, soft delete, and entity versioning. Zero manual WHERE clauses, ever.</p>
