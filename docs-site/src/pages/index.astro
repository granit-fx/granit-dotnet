      </button>
    </div>

    <div class="lp-code-panel" id="code-panel">
      <div class="lp-code-tabs" role="tablist">
        <button class="lp-code-tab" role="tab" aria-selected="true" data-tab="module">AppModule.cs</button>
        <button class="lp-code-tab" role="tab" aria-selected="false" data-tab="program">Program.cs</button>
      </div>
      <div class="lp-code-content">
        <div data-visible="true" data-panel="module" id="code-module">
          <pre><code><Fragment set:html={combos[defaultKey]} /></code></pre>
        </div>
        <div data-visible="false" data-panel="program" id="code-program">
          <pre><code><Fragment set:html={programHtml} /></code></pre>
        </div>
      </div>
      {Object.entries(combos).map(([key, html]) => (
        <template data-combo={key}><pre><code><Fragment set:html={html} /></code></pre></template>
      ))}
    </div>
  </section>

